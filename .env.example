# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000

# Long random string used to sign session cookies.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Salt for admin password hashes. Pick it once and keep it: changing it invalidates existing admin passwords.
PASSWORD_SALT=change-me-to-another-random-string

# First admin account, created on first run when data/database.json has no admins.
# In production the app refuses to start without ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# Public domain of the Raipur site, e.g. https://www.example.com (blank = relative links, no canonical tag)
SITE_URL=

# reCAPTCHA v3 site key for the forms (leave blank until a key is issued for the Raipur domain)
RECAPTCHA_SITE_KEY=

# Read-only review mode: loads data/database.seed.json into memory, saves nothing, blocks admin changes,
# and marks every page noindex. Always on when deployed to Vercel (the platform sets VERCEL=1).
PREVIEW_MODE=false

# On Vercel, add these in Project > Settings > Environment Variables:
#   SESSION_SECRET, PASSWORD_SALT, ADMIN_USERNAME, ADMIN_PASSWORD  (required; NODE_ENV is production there)
#   SITE_URL, RECAPTCHA_SITE_KEY                                    (optional)
