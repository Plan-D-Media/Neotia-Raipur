<!-- Book Appointment Modal -->
<div class="modal fade" id="enquiryModal" tabindex="-1" aria-labelledby="enquiryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content" style="border-radius: 16px; overflow: hidden; border: none; box-shadow: 0 10px 40px rgba(var(--black-rgb), 0.2);">
      <div class="modal-header" style="background: var(--theme-color); color: var(--white); border-bottom: none; padding: 18px 25px;">
        <h5 class="modal-title font-weight-bold" id="enquiryModalLabel" style="color: var(--white); font-size: 20px;">
          <i class="fas fa-calendar-check me-2" style="color: var(--snd-color);"></i> Book An Appointment
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4" id="modal-body">
        <!-- Progress Steps -->
        <div class="step-indicator d-flex align-items-center justify-content-center mb-4">
          <div class="step-item active d-flex align-items-center gap-2" id="step-indicator-1-pop">
            <span class="step-dot" style="width: 28px; height: 28px; border-radius: 50%; border: 2px solid var(--theme-color); display: flex; align-items: center; justify-content: center; font-weight: 700; color: var(--theme-color);">1</span>
            <span>Select Doctor</span>
          </div>
          <div class="step-line" style="flex: 1; max-width: 60px; height: 2px; background: var(--grey-200); margin: 0 10px;"></div>
          <div class="step-item d-flex align-items-center gap-2" id="step-indicator-2-pop">
            <span class="step-dot" style="width: 28px; height: 28px; border-radius: 50%; border: 2px solid var(--grey-300); display: flex; align-items: center; justify-content: center; font-weight: 700; color: var(--grey-400);">2</span>
            <span>Patient Info</span>
          </div>
        </div>

        <div id="mess_appointment_pop"></div>

        <!-- Step 1 Form -->
        <div id="booking-step-1-pop">
          <form id="book-appointment-form-pop-step-1">
            <input type="hidden" name="recaptchaResponse" id="recaptchaResponse_pop" value="dummy_recaptcha_ok">
            <div class="row g-3">
              <div class="col-md-6 mb-3">
                <label class="form-label font-weight-bold" style="color: var(--grey-800); font-weight: 400;">Speciality / Department <span class="text-danger">*</span></label>
                <select name="department_id" class="form-select select_department" data-target="#pop_doctor_select" required style="border-radius: 8px; padding: 10px 14px;">
                  <option value="">Select Speciality</option>
                  <% departments.forEach(dept => { %>
                    <option value="<%= dept.id %>##<%= dept.name %>"><%= dept.name %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6 mb-3">
                <label class="form-label font-weight-bold" style="color: var(--grey-800); font-weight: 400;">Doctor</label>
                <select name="doctor_id" id="pop_doctor_select" class="form-select" style="border-radius: 8px; padding: 10px 14px;">
                  <option value="">Select Doctor (or Any Doctor)</option>
                  <% doctors.forEach(doc => { %>
                    <option value="<%= doc.id %>##<%= doc.name %>"><%= doc.name %> (<%= doc.speciality %>)</option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6 mb-3">
                <label class="form-label font-weight-bold" style="color: var(--grey-800); font-weight: 400;">Preferred Date <span class="text-danger">*</span></label>
                <input type="date" name="appointment_date" class="form-control" required style="border-radius: 8px; padding: 10px 14px;">
              </div>
              <div class="col-md-6 mb-3">
                <label class="form-label font-weight-bold" style="color: var(--grey-800); font-weight: 400;">Preferred Time Slot</label>
                <select name="appointment_time" class="form-select" style="border-radius: 8px; padding: 10px 14px;">
                  <option value="Morning (9:00 AM - 1:00 PM)">Morning (9:00 AM - 1:00 PM)</option>
                  <option value="Afternoon (1:00 PM - 5:00 PM)">Afternoon (1:00 PM - 5:00 PM)</option>
                  <option value="Evening (5:00 PM - 8:00 PM)">Evening (5:00 PM - 8:00 PM)</option>
                </select>
              </div>
            </div>
            <div class="text-end mt-4">
              <button type="submit" id="getanappointment_pop" class="btn" style="background: var(--snd-color); color: var(--brand-blue-2-tint-3); font-weight: 700; padding: 10px 28px; border-radius: 25px; border: none;">
                Next Step <i class="fas fa-arrow-right ms-2"></i>
              </button>
              <div id="loading_appointment_img_pop" style="display: none;" class="ms-2">
                <i class="fas fa-spinner fa-spin text-primary"></i> Processing...
              </div>
            </div>
          </form>
        </div>

        <!-- Step 2 Form -->
        <div id="booking-step-2-pop" style="display: none;">
          <form id="book-appointment-form-pop-step-2">
            <input type="hidden" name="recaptchaResponse" value="dummy_recaptcha_ok">
            <div class="row g-3">
              <div class="col-md-6 mb-3">
                <label class="form-label" style="font-weight: 400;">Patient / Parent Name <span class="text-danger">*</span></label>
                <input type="text" name="name" class="form-control" placeholder="Enter Full Name" required style="border-radius: 8px; padding: 10px 14px;">
              </div>
              <div class="col-md-6 mb-3">
                <label class="form-label" style="font-weight: 400;">Phone Number <span class="text-danger">*</span></label>
                <input type="tel" name="phone" class="form-control" placeholder="10-digit Mobile Number" required pattern="[0-9]{10}" style="border-radius: 8px; padding: 10px 14px;">
              </div>
              <div class="col-md-6 mb-3">
                <label class="form-label" style="font-weight: 400;">Email Address</label>
                <input type="email" name="email" class="form-control" placeholder="youremail@example.com" style="border-radius: 8px; padding: 10px 14px;">
              </div>
              <div class="col-md-6 mb-3">
                <label class="form-label" style="font-weight: 400;">City / Area</label>
                <input type="text" name="address" class="form-control" placeholder="City or Area (e.g. Raipur)" style="border-radius: 8px; padding: 10px 14px;">
              </div>
              <div class="col-12 mb-3">
                <label class="form-label" style="font-weight: 400;">Medical Concern / Query (Optional)</label>
                <textarea name="query" class="form-control" rows="2" placeholder="Briefly describe symptoms or medical reason" style="border-radius: 8px; padding: 10px 14px;"></textarea>
              </div>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-4">
              <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('booking-step-2-pop').style.display='none'; document.getElementById('booking-step-1-pop').style.display='block';" style="border-radius: 25px; padding: 8px 22px;">
                <i class="fas fa-arrow-left me-1"></i> Back
              </button>
              <button type="submit" id="appointsubmitTriger_pop_2" class="btn" style="background: var(--theme-color); color: var(--white); font-weight: 700; padding: 10px 30px; border-radius: 25px; border: none;">
                Confirm Appointment <i class="fas fa-check-circle ms-2"></i>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Request Callback Modal -->
<%- include('callback-modal') %>
