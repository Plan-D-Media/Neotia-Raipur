<%#
  First section of every speciality page: the page's only H1 (the speciality name) and the
  2-step "Book Your Appointment" form. Used by views/<slug>.ejs and views/service-detail.ejs.
  - Submits through public/js/custom_form.js, the same flow as /book-an-appointment.
  - The department is pre-selected and its doctors pre-loaded (bookingDoctors, from server.js);
    picking another department reloads the doctor list (.select_department in custom_form.js).
  - Doctor list: "Any Doctor" first, then only doctors matched to the department (data-doctors="matched");
    a department with none shows just "Any Doctor". /book-an-appointment keeps its own list.
  - "Book An Appointment" in the action bar scrolls here ([data-speciality-booking], public/js/action-bar.js).
  - Styles: public/css/style.css "Speciality page booking form".
%>
<% const bookingDept = department.id + '##' + department.name; %>
<section class="speciality-booking" id="book_sectio" data-speciality-booking>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8">
                <h1 class="speciality-booking__title"><%= department.name %></h1>
                <h2 class="step_heading">Book Your Appointment</h2>

                <!-- Step Progress -->
                <div class="booking-steps">
                    <div class="step-indicator">
                        <div class="step-item active" id="step-indicator-1">
                            <div class="step-dot">1</div>
                            <span>Your details</span>
                        </div>
                        <div class="step-line"></div>
                        <div class="step-item" id="step-indicator-2">
                            <div class="step-dot">2</div>
                            <span>Appointment details</span>
                        </div>
                    </div>
                </div>

                <div class="booking-form">
                    <div id="mess_appointment"></div>
                    <div id="loading_appointment_img" style="display:none;"><i class="fa fa-spinner fa-spin"></i> Please wait..</div>

                    <!-- Step 1: Patient basics -->
                    <div class="booking-step" id="booking-step-1">
                        <form class="appointment-form" name="book-appointment-form-step-1" id="book-appointment-form-step-1" method="post">
                            <div class="row">
                                <div class="col-md-6">
                                    <label for="fname" class="visually-hidden">Patient Name</label>
                                    <input type="text" class="form-control" placeholder="Patient Name" name="fname" id="fname" autocomplete="name" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="mobile" class="visually-hidden">Mobile</label>
                                    <input type="text" class="form-control" placeholder="Mobile" inputmode="numeric" pattern="[0-9]*" name="mobile" id="mobile" autocomplete="tel" required>
                                </div>
                            </div>
                            <div class="text-end">
                                <input type="hidden" name="hlink" value="/<%= department.slug %>">
                                <input name="step" type="hidden" value="1">
                                <input name="getanappointment" type="hidden" value="1">
                                <input type="hidden" name="recaptcha_response" id="recaptchaResponse">
                                <button type="submit" id="appointsubmitTriger" class="submit-btn">Next →</button>
                            </div>
                        </form>
                    </div>

                    <!-- Step 2: Appointment details -->
                    <div class="booking-step" id="booking-step-2" style="display:none;">
                        <form class="appointment-form" name="book-appointment-form-step-2" id="book-appointment-form-step-2" method="post">
                            <div class="row">
                                <div class="col-md-6">
                                    <label for="email" class="visually-hidden">Email Id</label>
                                    <input type="email" class="form-control" placeholder="Email Id" name="email" id="email" autocomplete="email" required>

                                    <label for="department" class="visually-hidden">Speciality</label>
                                    <select class="form-select select_department" name="department" id="department" data-target="#consultant" data-doctors="matched" required>
                                        <% departments.forEach(dept => { %>
                                        <option value="<%= dept.id %>##<%= dept.name %>"<%= dept.id === department.id ? ' selected' : '' %>><%= dept.name %></option>
                                        <% }); %>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="consultant" class="visually-hidden">Doctor</label>
                                    <select class="form-select" name="consultant" id="consultant" required>
                                        <option value="">Select Doctor</option>
                                        <option value="Any Doctor">Any Doctor</option>
                                        <% bookingDoctors.forEach(doc => { %>
                                        <option value="<%= doc.id %>##<%= doc.name %>"><%= doc.name %></option>
                                        <% }); %>
                                    </select>

                                    <label for="preffered_date" class="visually-hidden">Preferred date</label>
                                    <div class="date-wrapper position-relative">
                                        <input type="date" class="form-control" min="<%= new Date().toISOString().split('T')[0] %>" name="preffered_date" id="preffered_date" required>
                                        <span class="calendar-icon"><i class="fa-solid fa-calendar-days"></i></span>
                                    </div>

                                    <input type="hidden" name="hospital_center" value="<%= siteInfo.hospitalCentre %>">
                                </div>
                            </div>
                            <div class="d-flex justify-content-between appoint">
                                <button type="button" id="step2-back-btn" class="submit-btn submit-btn--outline">← Back</button>
                                <input name="step" type="hidden" value="2">
                                <input name="getanappointment" type="hidden" value="1">
                                <button type="submit" id="appointsubmitTriger_2" class="submit-btn">Submit Request</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
// reCAPTCHA isn't loaded on the site yet: let custom_form.js run without it (same as /book-an-appointment)
if (typeof window.grecaptcha === 'undefined') {
    window.grecaptcha = {
        ready: function (cb) { cb(); },
        execute: function () { return Promise.resolve('dummy_recaptcha_ok'); }
    };
}

// Step 2 "Back" returns to the patient details
document.addEventListener('DOMContentLoaded', function () {
    var backBtn = document.getElementById('step2-back-btn');
    if (!backBtn) return;
    backBtn.addEventListener('click', function () {
        document.getElementById('booking-step-2').style.display = 'none';
        document.getElementById('booking-step-1').style.display = 'block';
        var ind1 = document.getElementById('step-indicator-1');
        ind1.classList.add('active');
        ind1.classList.remove('done');
        ind1.querySelector('.step-dot').textContent = '1';
        document.getElementById('step-indicator-2').classList.remove('active');
        document.getElementById('fname').focus();
    });
});
</script>
