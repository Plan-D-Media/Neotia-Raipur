    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
}
.step-item.active .step-dot { 
    border-color: var(--brand-blue-1); 
    color: var(--snd-color, var(--brand-orange)); 
}
.step-item.done .step-dot {
    border-color: var(--brand-blue-1);
    background: var(--brand-blue-1);
    color: var(--white);
}
.step-line {
    flex: 1;
    height: 1px;
    background: var(--grey-200);
    margin: 0 12px;
}
.submit-btn--outline {
    background: transparent;
    border: 2px solid currentColor;
    color: var(--grey-700);
}
.appoint {
    gap: 24px;
}
.booking-steps {
    width: 57%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 0 auto 25px;
}
.step-indicator {
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.step-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--grey-400);
}
.step-item.active {
    color: var(--grey-800);
    font-weight: 700;
}
.step-item.done {
    color: var(--black);
}

@media only screen and (min-width: 320px) and (max-width: 767px) {
