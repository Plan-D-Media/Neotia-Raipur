<!-- content tabs sec start -->
<section class="content-tabs-sec section-padding">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="panels">
                    <section id="tab1" class="panel active fade-in" role="tabpanel" aria-labelledby="t1">
                        <h3 class="fadeInUp animatable">Paediatric Gastroenterology and Hepatology</h3>
                        <p class="fadeInUp animatable">At our Paediatric Gastroenterology Department, we are dedicated to the diagnosis, treatment and long-term management of digestive, liver and nutritional conditions in children, from newborns to adolescents. With a compassionate team and cutting-edge technology, we provide personalised treatment plans designed to ensure every child receives the expert care they deserve.</p>
                        <p class="pt-4 fadeInUp animatable">Our Specialised Services include:</p>

                        <div class="workup-sec mt-3">
                            <!-- Diagnostic Work Up -->
                            <h4 class="py-3 fadeInUp animatable">Diagnostic Work Up</h4>
                            <ul class="listing-apps">
                                <li class="fadeInUp animatable first_class">
                                    <div class="mb-2">
                                        <h5>Paediatric Endoscopy (Gastroscopy and Colonoscopy)</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>Diagnostic Assessment:</strong> Allows for the direct visualisation of the oesophagus, stomach, small bowel and colon to identify inflammation, polyps, ulcers or structural anomalies.</p>
                                    </div>
                                    <div>
                                        <p><strong>Biopsy Sampling: </strong> Enables the collection of tissue samples for definitive diagnosis of conditions like Coeliac Disease, Inflammatory Bowel Disease (IBD) and eosinophilic oesophagitis.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Capsule Endoscopy</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>A non-invasive procedure using a tiny, swallowed camera to examine the entire small intestine, often used for suspected small bowel bleeding or Crohn's Disease.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div>
                                        <h5>PH Metry with Impedance</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>Measures both acidic and non-acidic reflux episodes to diagnose Gastro-Oesophageal Reflux Disease (GORD) and assess the effectiveness of treatment.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Breath Tests</h5>
                                    </div>
                                    <p><strong>Hydrogen/Methane Breath Tests:</strong> Used to diagnose Small Intestinal Bacterial Overgrowth (SIBO) and various carbohydrate intolerances, such as lactose and fructose intolerance.</p>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Complete Fatty Liver Package:</h5>
                                    </div>
                                    <p>1. Biochemical parameters<br />2. USG for Fat (Liver)<br />3. Liver Elastography (FibroScan)<br />4. MLD Elastography (Country Body)<br />5. Dietary consultation</p>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Diagnostic Liver Imaging and Biopsy</h5>
                                    </div>
                                    <p>Utilising advanced ultrasound and MRI techniques to assess liver structure, along with minimally invasive liver biopsies for definitive diagnosis of chronic liver diseases.</p>
                                </li>
                            </ul>

                            <!-- Interventional Paediatric Gastroenterology -->
                            <h4 class="py-3 mt-4 fadeInUp animatable">Interventional Paediatric Gastroenterology</h4>
                            <ul class="listing-apps">
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Polypectomy</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>The removal of polyps from the colon during a colonoscopy is performed to prevent future complications.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div>
                                        <h5>Foreign Body Removal</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>Endoscopic retrieval of accidentally ingested foreign objects from the upper digestive tract.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Endoscopic Dilatation</h5>
                                    </div>
                                    <p>Widening of narrowed sections (strictures) of the oesophagus or bowel, often necessary after inflammation or surgery.</p>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Percutaneous Endoscopic Gastrostomy (PEG) Tube Placement</h5>
                                    </div>
                                    <p>Endoscopic placement of a feeding tube directly into the stomach for children requiring long-term nutritional support.</p>
                                </li>
                            </ul>

                            <!-- Medical Management and Specialised Care -->
                            <h4 class="py-3 mt-4 fadeInUp animatable">Medical Management and Specialised Care</h4>
                            <ul class="listing-apps">
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Coeliac Disease and Food Allergies/Intolerances</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>Comprehensive Diagnostics: </strong>Including serological testing and endoscopy with biopsies for Coeliac Disease.</p>
                                        <p><strong>Dietary Management: </strong>Expert guidance from our dietetics team for strict, lifelong gluten-free diets or elimination diets for allergies.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Inflammatory Bowel Disease (IBD): Crohn's Disease and Ulcerative Colitis</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>These chronic conditions cause inflammation in the digestive tract. Our approach includes:</p>
                                        <p><strong>Advanced Medical Therapy: </strong>Utilising immunosuppressants and biologics to induce and maintain remission.</p>
                                    </div>
                                </li>
                            </ul>

                            <h4 class="py-3 mt-4 fadeInUp animated">Drug Monitoring: INFLIXIMAB &amp; ADALIMUMAB</h4>
                            <p class="fadeInUp animated">Nutritional Support: Addressing potential malnutrition and growth issues, often involving specific dietary plans or enteral feeding.</p>

                            <h4 class="py-3 mt-4 fadeInUp animated">Achalasia Cardia</h4>
                            <div class="mb-2">
                                <h5>1. UGI Manometry for Dilation and Therapeutic CRE Dilation</h5>
                            </div>

                            <ul class="listing-apps">
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Chronic Constipation and Soiling (Encopresis)</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>A multi-faceted approach to manage complex constipation, including:</p>
                                        <p><strong>Medical Laxative Regimens:</strong> Tailored use of medication to ensure regular, comfortable bowel movements.</p>
                                        <p><strong>Behavioural Therapy: </strong>Education and support for families and children to establish healthy toileting habits.</p>
                                    </div>
                                </li>

                                <!-- Speciality Banner -->
                                <li class="fadeInUp animatable speciality_banner_no">
                                    <img class="img-fluid speciality_banner" src="/upload/fileManager/specialise_banner/PaediatricGastroenterology.png" alt="Paediatric Gastroenterology" />
                                </li>

                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Additional Diagnostic &amp; Therapeutic Options:</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>1. LGI Manometry<br />2. Bio Feedback Therapy </strong></p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Liver Diseases (Hepatology)</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>We specialise in managing acute and chronic liver conditions, including Biliary Atresia, autoimmune hepatitis and fatty liver disease. Treatment involves:</p>
                                        <p><strong>Medication Management: </strong>For conditions such as cholestasis and portal hypertension.</p>
                                        <p><strong>Pre- and Post-Liver Transplant Care: </strong>Comprehensive support in conjunction with specialist transplant centres.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Gastro-Oesophageal Reflux Disease (GORD) and Eosinophilic Oesophagitis (EoE)</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>Medical Regimens: </strong>Using acid-suppressing medication and, in the case of EoE, specialised dietary or topical steroid therapy.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Intestinal Failure and Nutritional Support</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>For children who cannot absorb nutrients normally, we provide:</p>
                                        <p><strong>Enteral and Parenteral Nutrition: </strong>Delivering essential nutrients via feeding tubes (enteral) or directly into the bloodstream (parenteral/Total Parenteral Nutrition - TPN).</p>
                                        <p><strong>Monitoring: </strong>Close monitoring of fluid balance, blood chemistry and growth parameters.</p>
                                    </div>
                                </li>
                            </ul>

                            <h4 class="py-3 mt-4 fadeInUp animated">Nutrition and Dietetics</h4>
                            <p class="fadeInUp animated">Our dedicated paediatric dietitians work closely with the medical team to ensure optimal growth and development.</p>
                            <p class="pt-2 fadeInUp animated">Our Specialised Services include:</p>
                            <ul class="listing-apps second_tabb">
                                <li class="fadeInUp animated">
                                    <div class="mb-2">
                                        <h5>Faltering Growth (Failure to Thrive)</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>Detailed assessment and intervention for poor weight gain.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animated">
                                    <div>
                                        <h5>Therapeutic Diets</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>Guidance for specific medical needs, such as ketogenic diets, low FODMAP diets and exclusion diets for allergies or IBD.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animated">
                                    <div class="mb-2">
                                        <h5>Enteral and Parenteral Feeding Regimens</h5>
                                    </div>
                                    <p>Planning and monitoring of all forms of artificial nutritional support.</p>
                                </li>
                            </ul>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</section>
