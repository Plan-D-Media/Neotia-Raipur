<!-- ========================================== -->
<!-- 5. OUR DOCTORS CAROUSEL SECTION             -->
<!-- ========================================== -->
<section class="home-testimonial section-padding">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center mb-4 fadeInUp animatable">
                <h2 class="section-heading">Our Doctors</h2>
                <p>Choose the speciality- Find &amp; select the doctor- Book an appointment</p>
            </div>
            <div class="sec00-doctor owl-carousel mt-0">
                <% doctors.forEach(doc => { %>
                    <div class="sec001-item fadeInUp animatable">
                        <div class="img-doctor">
                            <img src="<%= doc.image ? (doc.image.startsWith('http') ? doc.image : (doc.image.startsWith('/') ? doc.image : '/' + doc.image)) : '/img/about-img.png' %>" alt="<%= doc.name %>" onerror="this.src='/img/about-img.png'">
                            <h4 class="doctor-name"><%= doc.name %></h4>
                        </div>
                        <div class="doctor-content">
                            <h5><%= doc.speciality %></h5>
                            <% if (doc.experience && doc.experience.trim()) { %>
                                <span><%= doc.experience %></span>
                            <% } %>
                            <% if (doc.qualifications) { %>
                                <p><%= doc.qualifications %></p>
                            <% } %>
                            <% if (doc.regNo && doc.regNo.trim()) { %>
                                <p><%= doc.regNo %></p>
                            <% } %>
                            <a href="/doctor/<%= doc.slug %>">View Profile</a>
                        </div>
                        <a href="/book-an-appointment?doctor=<%= encodeURIComponent(doc.name) %>" class="book-app">Book Appointment</a>
                    </div>
                <% }); %>
            </div>
        </div>
    </div>
</section>

