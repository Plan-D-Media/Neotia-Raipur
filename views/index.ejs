<!-- Carousel and Video initialization -->
<script>
$(document).ready(function () {
    // 1. Paediatric Care Services Carousel
    $(".area-card-about").owlCarousel({
        loop: true,
        margin: 20,
        nav: false,
        dots: true,
        autoplay: true,
        autoplaySpeed: 1000,
        smartSpeed: 1200,
        responsive: {
            0: { items: 1, margin: 10 },
            480: { items: 2, margin: 10 },
            768: { items: 3, margin: 15 },
            992: { items: 4, margin: 20 }
        }
    });

    // 2. Doctor Carousel (if not handled by custom.js)
    if (!$(".sec00-doctor").hasClass("owl-loaded")) {
        $(".sec00-doctor").owlCarousel({
            dots: true,
            nav: false,
            margin: 15,
            autoplay: true,
            autoplaySpeed: 1000,
            smartSpeed: 1500,
            loop: true,
            responsive: {
                0: { items: 1 },
                600: { items: 2 },
                992: { items: 3 }
            }
        });
    }

    // 3. Media Coverage Carousel
    if (!$(".media-carousel").hasClass("owl-loaded")) {
        $(".media-carousel").owlCarousel({
            loop: true,
            margin: 30,
            nav: false,
            dots: false,
            autoplay: true,
            autoplayTimeout: 4000,
            smartSpeed: 800,
            responsive: {
                0: { items: 1 },
                768: { items: 1 },
                992: { items: 2 }
            }
        });
    }

    // 4. What's New Blogs Carousel
    $(".whats-new-area").owlCarousel({
        loop: true,
        margin: 25,
        nav: false,
        dots: true,
        autoplay: true,
        autoplayTimeout: 4500,
        smartSpeed: 800,
        responsive: {
            0: { items: 1 },
            600: { items: 2 },
            992: { items: 3 }
        }
    });

    // 5. Initialize Fancybox for video popups
    if (window.Fancybox) {
        Fancybox.bind("[data-fancybox]", {
            Thumbs: false,
            Toolbar: true
        });
    }
});
</script>
