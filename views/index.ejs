<%- include('partials/header', { 
    title: (typeof page !== 'undefined' && page && page.seoTitle) ? page.seoTitle : 'Paediatric & Child Hospital in Raipur | Neotia Bhagirathi',
    description: (typeof page !== 'undefined' && page && page.metaDescription) ? page.metaDescription : 'Looking for a pediatric or child hospital in Raipur? Neotia Bhagirathi provides expert pediatricians advanced child care & compassionate treatment in Raipur.',
    bodyClass: 'index-main',
    bodyId: 'home-page'
}) %>

<!-- ========================================== -->
<!-- 1. HERO BANNER SECTION WITH VIDEO           -->
<!-- ========================================== -->
<section class="banner-sec" id="home-banner">
    <div class="banner-area">
        <video autoplay="" muted="" loop="" playsinline="" poster="/img/home-banner.png" style="width: 100%; object-fit: cover;">
            <source src="/img/banner_video.mp4" type="video/mp4">
            Your browser does not support the video tag.
        </video>
        <div class="banner-overley">
            <div class="container">
                <div class="row justify-content-center align-items-center">
                    <div class="col-lg-12">
                        <div class="home-banner-text">
                            <h1 class="fadeInUp animatable" style="color: var(--white) !important;"><%= (typeof page !== 'undefined' && page && page.heading) ? page.heading : 'Eastern India’s Trusted Name in Child Care' %></h1>
                            <div class="banner-main-form">
                                <form class="banner-form" id="searchform" name="searchform" action="/find-a-doctor" method="GET">
                                    <input type="text" id="searchInput" name="search" autocomplete="off" placeholder="Search For Doctor & Specialties...">
                                    <button type="submit" class="srh-btn" aria-label="Search">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 48 48" fill="#ffffff">
                                            <path d="m40.9 39.485-7.813-7.812a14.878 14.878 0 0 0 3.72-9.865c0-4.007-1.56-7.774-4.393-10.607s-6.6-4.393-10.606-4.393S14.034 8.368 11.2 11.2s-4.393 6.6-4.393 10.607 1.56 7.773 4.393 10.606 6.6 4.394 10.607 4.394c3.67 0 7.13-1.323 9.865-3.721l7.812 7.812a.997.997 0 0 0 1.414 0 1 1 0 0 0 0-1.414zM12.614 31c-2.455-2.456-3.807-5.72-3.807-9.192s1.352-6.737 3.807-9.193c2.456-2.455 5.72-3.807 9.193-3.807S28.544 10.16 31 12.615c2.455 2.456 3.808 5.72 3.808 9.193S33.455 28.544 31 31c-2.456 2.455-5.72 3.808-9.192 3.808S15.07 33.455 12.615 31z"></path>
                                        </svg>
                                    </button>
                                </form>
                                <!-- Trending Suggestions Box -->
                                <div class="trending-box" id="trendingBox">
                                    <div class="tags" id="suggestions"></div>
                                    <div class="tags" id="initial_srch_div">
                                        <h4>Specialties</h4>
                                        <div class="tag-details">
                                            <% departments.slice(0, 10).forEach(dept => { %>
                                                <span><a href="/<%= dept.slug %>"><%= dept.name %></a></span>
                                            <% }); %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <p class="from-pera home_button">
                                <a href="<%= (typeof page !== 'undefined' && page && page.ctaLink) ? page.ctaLink : '/book-an-appointment' %>"><%= (typeof page !== 'undefined' && page && page.ctaText) ? page.ctaText : 'Book Appointment' %></a>
                                <a href="javascript:void(0)" class="home_call open_modal_callback" data-bs-toggle="modal" data-bs-target="#requestcallback">Request a Callback</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ========================================== -->
<!-- 2. ABOUT US SECTION WITH PLAY VIDEO MODAL   -->
<!-- ========================================== -->
<section class="about-sec section-padding">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="about-content">
                    <h2 class="section-heading mb-3 fadeInUp animatable">
                        <% if (typeof page !== 'undefined' && page && page.subheading) { %>
                            <%= page.subheading %>
                        <% } else { %>
                            East India's Trusted <br>
                            Destination for Woman <br>
                            <span>&amp; Child Care</span>
                        <% } %>
                    </h2>
                    <div class="about-text-content">
                        <% if (typeof page !== 'undefined' && page && page.content) { %>
                            <% page.content.split('\n').map(p => p.trim()).filter(Boolean).forEach(para => { %>
                                <p class="fadeInUp animatable mb-3"><%= para %></p>
                            <% }); %>
                        <% } else { %>
                            <p class="fadeInUp animatable">
                                Your journey to safe motherhood and a healthy childhood starts here. We offer advanced maternity services, specialised paediatric care and a wide range of treatments tailored to children’s unique needs. Our expert teams provide personalised support, underpinned by the latest medical technology and evidence-based practices.
                            </p>
                            <p class="fadeInUp animatable">
                                Proudly recognised as the Best Child Specialist Hospital in East India, we are dedicated to delivering clinical excellence with empathy, ensuring the best possible outcomes for both mothers and children.
                            </p>
                        <% } %>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="about-img fadeInUp animatable position-relative">
                    <img src="<%= (typeof page !== 'undefined' && page && page.heroImage) ? page.heroImage : '/img/about-img.png' %>" alt="<%= (typeof page !== 'undefined' && page && page.altText) ? page.altText : 'East India\'s Trusted Destination for Woman & Child Care' %>" class="img-fluid" onerror="this.src='/img/landing.webp'">
                    <a class="play-btn" data-fancybox="about-video" href="https://youtu.be/VAnJaaz0EaI?si=diXF7PHw3Tpizw_E" aria-label="Play Hospital Introduction Video"></a>
                </div>
            </div>
        </div>
    </div>
    <img src="/img/big-plus.png" alt="big plus" class="abs-1">
    <img src="/img/opacity-plus.png" alt="opacity plus" class="abs-2">
</section>

<!-- ========================================== -->
