    <div class="banner-area">
        <div class="container">
            <div class="row justify-content-center align-items-center">
                <div class="col-md-6 col-lg-5">
                    <p class="fadeInUp animatable">From the first heartbeat to the first cry, we walk beside every mother, keeping both hearts safe and sound.</p>
                </div>
                <div class="col-md-6 col-lg-7">
                    <div class="banner-img">
                        <img src="/upload/fileManager/banner/foetal_medicine_hero_banner.jpg" alt="Foetal Medicine and Maternal Care" class="img-fluid">
                    </div>
                </div>
            </div>
        </div>
