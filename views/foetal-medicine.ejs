<link rel="stylesheet" href="/css/inner_style.css">

<style>

/* Banner image styling */
.banner-sec {
    background: var(--grey-bg);
    padding-top: 55px !important;
    padding-bottom: 55px !important;
    position: relative;
}
@media (max-width: 991px) {
    .banner-sec {
        padding-top: 40px !important;
        padding-bottom: 40px !important;
    }
}
.banner-area .banner-img img {
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(var(--brand-blue-1-rgb), 0.12);
    width: 100%;
    max-height: 440px;
    object-fit: cover;
}

/* Speciality banner in content */
.speciality_banner_no {
    list-style: none !important;
    padding: 0 !important;
    margin: 30px 0 !important;
    text-align: center;
    grid-column: 1 / -1;
}
.speciality_banner_no img {
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(var(--black-rgb), 0.06);
    max-width: 100%;
}

/* Diagnostic scans grid */
.content-001area {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 16px;
    margin-bottom: 30px;
}
@media (max-width: 991px) {
    .content-001area {
        grid-template-columns: repeat(2, 1fr);
    }
}
@media (max-width: 575px) {
    .content-001area {
        grid-template-columns: 1fr;
    }
}
.oo1-item {
    padding: 20px;
    background: var(--white);
    border: 1px solid var(--grey-100);
    border-radius: 10px;
    font-weight: 400;
    color: var(--brand-blue-2-tint-3);
    box-shadow: 0 2px 6px rgba(var(--black-rgb), 0.03);
    transition: all 0.3s ease;
}
.oo1-item:hover {
    border-color: var(--snd-color, var(--brand-orange));
    box-shadow: 0 6px 16px rgba(var(--black-rgb), 0.08);
    transform: translateY(-2px);
}

/* Case studies video items */
.doctors-item {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    max-width: 480px;
}
.doctors-item img {
    border-radius: 12px;
    transition: transform 0.4s ease;
    width: 100%;
}
.doctors-item:hover img {
    transform: scale(1.03);
}
.right-plus {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 38px;
    height: 38px;
    background: rgba(var(--brand-orange-rgb), 0.95);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 10px rgba(var(--black-rgb), 0.25);
    transition: transform 0.3s ease;
}
.doctors-item:hover .right-plus {
    transform: scale(1.12);
}
.right-plus img {
    width: 18px;
    height: 18px;
}
</style>

