<%- include('partials/header', { 
    title: "Fertility & IVF in Raipur | Neotia Bhagirathi",
    description: "Neotia Bhagirathi provides expert IVF and fertility treatment in Raipur with advanced reproductive technologies and personalised care.",
    bodyClass: 'specalities'
