<%- include('partials/header', { 
    title: 'Book Appointment | Best Gynecologist & Pediatrician New Town',
    description: 'Easily book appointments with leading doctors at Neotia Bhagirathi, New Town. Trusted maternity, gynecology and child care hospital in Rajarhat, Kolkata.',
    bodyClass: 'inner-page appointment-page'
}) %>

<!-- Clean, Catchy, Ultra-Readable Hero Banner Section -->
<section class="appointment-hero-section" id="doctor-list-banner">
    <div class="container">
        <div class="row align-items-center">
            
            <!-- Left: High-Contrast, Catchy Value Proposition -->
            <div class="col-lg-7 col-xl-7">
                <nav aria-label="breadcrumb" class="book-breadcrumb-nav">
                    <ol>
                        <li><a href="/">Home</a></li>
                        <li style="color: rgba(var(--white-rgb), 0.45); font-size: 11px;">/</li>
                        <li class="active" aria-current="page">Book an Appointment</li>
                    </ol>
                </nav>

                <div class="hero-pill-badge">
                    <i class="fa-solid fa-star-of-life"></i> Priority OPD &amp; Specialist Care
                </div>

                <h1 class="hero-title">
                    Time is precious and<br>
                    <span class="highlight-yellow">your Health is priceless.</span>
                </h1>

                <p class="hero-subtext">
                    Choose timely diagnosis, trusted doctor care, and lasting peace of mind. Consult senior specialists in paediatric, maternity, and surgical care in Raipur.
                </p>

                <!-- Clean, Balanced Trust Cards -->
                <div class="hero-trust-cards">
                    <div class="hero-trust-item">
                        <i class="fa-solid fa-user-doctor"></i>
                        <span>50+ Top Specialists</span>
                    </div>
                    <div class="hero-trust-item">
                        <i class="fa-solid fa-bolt"></i>
                        <span>Instant Confirmation</span>
                    </div>
                    <div class="hero-trust-item">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>NABH Accredited Care</span>
                    </div>
                </div>

                <!-- Clean Action Buttons -->
                <div class="hero-action-buttons">
                    <a href="#book_sectio" class="btn-book-slot-now">
                        <i class="fa-solid fa-calendar-check"></i> Book Your Slot Below &darr;
                    </a>
                    <a href="tel:<%= siteInfo.emergencyNumbers[0].replace(/\s+/g, '') %>" class="btn-hero-contact">
                        <i class="fa-solid fa-phone-volume"></i> Emergency: <%= siteInfo.emergencyNumbers[0] %>
                    </a>
                </div>
            </div>

            <!-- Right: Watermark-Free, Professional Doctor Visual -->
            <div class="col-lg-5 col-xl-5 mt-4 mt-lg-0">
                <div class="hero-image-card">
                    <img src="/img/clean-doctor-banner.jpg" alt="Neotia Bhagirathi Specialist Care" class="img-fluid">
                    <div class="hero-floating-badge">
                        <div class="badge-icon">
                            <i class="fa-solid fa-heart-pulse"></i>
                        </div>
                        <div class="badge-text">
                            <h6>24/7 Dedicated Care</h6>
                            <p>Emergency, NICU &amp; OPD Services</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- 2-Step Appointment Booking Section -->
<section id="book_sectio" class="book-sec section-padding">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <div class="mb-4 text-center fade-up animatable">
                    <h2 class="section-heading">Your schedule, simplified.</h2>
                    <p class="section-subtext">Choose the speciality - Find &amp; select the doctor - Book an appointment</p>
                </div>

                <!-- Step Progress Indicator -->
                <div class="booking-steps fade-up animatable">
                    <div class="step-indicator">
                        <div class="step-item active" id="step-indicator-1">
                            <div class="step-dot">1</div>
                            <span>Your details</span>
                        </div>
                        <div class="step-line"></div>
                        <div class="step-item" id="step-indicator-2">
                            <div class="step-dot">2</div>
                            <span>Appointment details</span>
                        </div>
                    </div>
                </div>

                <!-- Booking Card -->
                <div class="booking-card-wrapper fade-up animatable">
                    <div id="mess_appointment"></div>
                    <div id="loading_appointment_img" style="display:none;" class="text-center py-2 text-primary fw-bold">
                        <i class="fa fa-spinner fa-spin me-2"></i> Please wait...
                    </div>

                    <!-- Step 1: Patient basics -->
                    <div class="booking-step" id="booking-step-1">
                        <form name="book-appointment-form-step-1" id="book-appointment-form-step-1" method="post">
                            <div class="row">
                                <div class="col-lg-6">
                                    <label class="form-label text-muted small fw-semibold">Patient Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" placeholder="Enter Full Name" name="fname" id="fname" required>
                                </div>
                                <div class="col-lg-6">
                                    <label class="form-label text-muted small fw-semibold">Mobile Number <span class="text-danger">*</span></label>
                                    <input type="tel" class="form-control" placeholder="10-digit Mobile Number" inputmode="numeric" pattern="[0-9]*" name="mobile" id="mobile" required>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-12 text-end">
                                    <input type="hidden" name="hlink" value="/book-an-appointment" />
                                    <input type="hidden" name="ip" value="127.0.0.1" />
                                    <input name="step" type="hidden" value="1">
                                    <input name="getanappointment" type="hidden" value="1">
                                    <input type="hidden" name="recaptcha_response" id="recaptchaResponse" value="dummy_recaptcha_ok">

                                    <button type="submit" id="appointsubmitTriger" class="submit-btn">
                                        Next &rarr;
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Step 2: Appointment details -->
                    <div class="booking-step" id="booking-step-2" style="display:none;">
                        <form name="book-appointment-form-step-2" id="book-appointment-form-step-2" method="post">
                            <div class="row">
                                <div class="col-lg-6">
                                    <label class="form-label text-muted small fw-semibold">Email Address <span class="text-danger">*</span></label>
                                    <input type="email" class="form-control" placeholder="name@domain.com" name="email" id="email" required>

                                    <label class="form-label text-muted small fw-semibold">Speciality / Department <span class="text-danger">*</span></label>
                                    <select class="form-select select_department" name="department" id="department" data-target="#consultant" required>
                                        <option value="">Choose Speciality</option>
                                        <% departments.forEach(dept => { %>
                                            <option value="<%= dept.id %>##<%= dept.name %>" <%= (typeof query !== 'undefined' && query.department === dept.name) ? 'selected' : '' %>>
                                                <%= dept.name %>
                                            </option>
                                        <% }); %>
                                    </select>
                                </div>

                                <div class="col-lg-6">
                                    <label class="form-label text-muted small fw-semibold">Specialist Doctor <span class="text-danger">*</span></label>
                                    <select class="form-select" name="consultant" id="consultant" required>
                                        <option value="">Doctor</option>
                                        <% doctors.forEach(doc => { %>
                                            <option value="<%= doc.id %>##<%= doc.name %>" <%= (typeof query !== 'undefined' && query.doctor === doc.name) ? 'selected' : '' %>>
                                                <%= doc.name %>
                                            </option>
                                        <% }); %>
                                    </select>

                                    <label class="form-label text-muted small fw-semibold">Preferred Consultation Date <span class="text-danger">*</span></label>
                                    <div class="date-wrapper position-relative">
                                        <input type="date" class="form-control" placeholder="Select Date" min="<%= new Date().toISOString().split('T')[0] %>" name="preffered_date" id="preffered_date" required>
                                        <span class="calendar-icon"><i class="fa-solid fa-calendar-days"></i></span>
                                    </div>

                                    <input type="hidden" name="hospital_center" class="form-control readonly-field" value="<%= siteInfo.hospitalCentre %>" readonly>
                                </div>
                            </div>

                            <div class="row mt-3">
                                <div class="col-12 d-flex justify-content-between align-items-center">
                                    <button type="button" id="step2-back-btn" class="submit-btn submit-btn--outline">
                                        &larr; Back
                                    </button>
                                    <input name="step" type="hidden" value="2">
                                    <input name="getanappointment" type="hidden" value="1">
                                    <button type="submit" id="appointsubmitTriger_2" class="submit-btn">
                                        Request an appointment
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- reCAPTCHA v3 & Searchable Doctor dropdown helper -->
<script>
    // Safeguard for grecaptcha
    if (typeof window.grecaptcha === 'undefined') {
        window.grecaptcha = {
            ready: function (cb) { cb(); },
            execute: function () { return Promise.resolve('dummy_recaptcha_ok'); }
        };
    }

    // Step 2 Back Button
    document.addEventListener("DOMContentLoaded", function () {
        var backBtn = document.getElementById("step2-back-btn");
        if (backBtn) {
            backBtn.addEventListener("click", function () {
                document.getElementById("booking-step-2").style.display = "none";
                document.getElementById("booking-step-1").style.display = "block";
                var ind1 = document.getElementById("step-indicator-1");
                var ind2 = document.getElementById("step-indicator-2");
                ind1.classList.add("active");
                ind1.classList.remove("done");
                ind1.querySelector(".step-dot").innerHTML = "1";
                ind2.classList.remove("active");
            });
        }
    });

    // ===== Searchable Doctor Dropdown Enhancer =====
    (function () {
        var PLACEHOLDER = "Search Doctor";
        var SEARCH_PROMPT = "Search Doctor here...";

        function isRealDoctorSelect(sel) {
            return sel && sel.tagName === "SELECT" && !sel.disabled && sel.name === "consultant";
        }

        function buildOptions(list, nativeSel, ss) {
            list.innerHTML = "";
            var opts = nativeSel.options;
            var added = 0;
            for (var i = 0; i < opts.length; i++) {
                var o = opts[i];
                var val = o.value;
                var txt = (o.textContent || "").trim();
                if (val === "" || /^select doctor$/i.test(txt) || /^doctor$/i.test(txt)) {
                    continue;
                }
                var li = document.createElement("li");
                li.textContent = txt;
                li.setAttribute("data-value", val);
                if (nativeSel.value === val && val !== "") {
                    li.className = "ss-selected";
                }
                list.appendChild(li);
                added++;
            }
            if (added === 0) {
                var empty = document.createElement("li");
                empty.className = "ss-empty";
                empty.textContent = "No doctors available. Please select a speciality first.";
                list.appendChild(empty);
            }
        }

        function syncDisplay(display, nativeSel) {
            var sel = nativeSel.options[nativeSel.selectedIndex];
            var txt = sel ? (sel.textContent || "").trim() : "";
            if (!nativeSel.value || nativeSel.value === "" || /^select doctor$/i.test(txt) || /^doctor$/i.test(txt)) {
                display.firstChild.nodeValue = PLACEHOLDER;
                display.classList.add("ss-placeholder");
            } else {
                display.firstChild.nodeValue = txt;
                display.classList.remove("ss-placeholder");
            }
        }

        function filterList(list, q) {
            q = (q || "").toLowerCase().trim();
            var items = list.querySelectorAll("li[data-value]");
            var shown = 0;
            items.forEach(function (li) {
                var match = li.textContent.toLowerCase().indexOf(q) !== -1;
                li.style.display = match ? "" : "none";
                if (match) shown++;
            });
            var empty = list.querySelector(".ss-empty-search");
            if (shown === 0) {
                if (!empty) {
                    empty = document.createElement("li");
                    empty.className = "ss-empty ss-empty-search";
                    empty.textContent = "No doctor found";
                    list.appendChild(empty);
                }
                empty.style.display = "";
            } else if (empty) {
                empty.style.display = "none";
            }
        }

        function enhance(nativeSel) {
            if (!isRealDoctorSelect(nativeSel) || nativeSel.dataset.ssDone === "1") return;
            nativeSel.dataset.ssDone = "1";

            var ss = document.createElement("div");
            ss.className = "searchable-select";
            nativeSel.parentNode.insertBefore(ss, nativeSel);
            ss.appendChild(nativeSel);
            nativeSel.classList.add("ss-native");

            var display = document.createElement("div");
            display.className = "ss-display ss-placeholder";
            display.appendChild(document.createTextNode(PLACEHOLDER));
            ss.appendChild(display);

            var panel = document.createElement("div");
            panel.className = "ss-panel";
            panel.innerHTML =
                '<div class="ss-search-wrap"><input type="text" class="ss-search" placeholder="' +
                SEARCH_PROMPT + '" autocomplete="off"></div><ul class="ss-options"></ul>';
            ss.appendChild(panel);

            var search = panel.querySelector(".ss-search");
            var list = panel.querySelector(".ss-options");

            buildOptions(list, nativeSel, ss);
            syncDisplay(display, nativeSel);

            function open() {
                ss.classList.add("open");
                search.value = "";
                filterList(list, "");
                setTimeout(function () { search.focus(); }, 30);
            }
            function close() {
                ss.classList.remove("open");
            }
            function toggle() {
                ss.classList.contains("open") ? close() : open();
            }

            display.addEventListener("click", function (e) {
                e.stopPropagation();
                toggle();
            });

            search.addEventListener("input", function () {
                filterList(list, this.value);
            });
            search.addEventListener("click", function (e) { e.stopPropagation(); });

            list.addEventListener("click", function (e) {
                var li = e.target.closest("li[data-value]");
                if (!li) return;
                var val = li.getAttribute("data-value");
                nativeSel.value = val;
                nativeSel.dispatchEvent(new Event("change", { bubbles: true }));
                list.querySelectorAll("li.ss-selected").forEach(function (x) {
                    x.classList.remove("ss-selected");
                });
                li.classList.add("ss-selected");
                syncDisplay(display, nativeSel);
                close();
            });

            document.addEventListener("click", function (e) {
                if (!ss.contains(e.target)) close();
            });

            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") close();
            });

            var mo = new MutationObserver(function () {
                buildOptions(list, nativeSel, ss);
                syncDisplay(display, nativeSel);
                if (ss.classList.contains("open")) filterList(list, search.value);
            });
            mo.observe(nativeSel, { childList: true });

            nativeSel.addEventListener("change", function () {
                syncDisplay(display, nativeSel);
            });
        }

        function scan() {
            document.querySelectorAll("select#consultant, select[name='consultant']").forEach(enhance);
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", scan);
        } else {
            scan();
        }
        window.addEventListener("load", scan);
    })();
</script>

<%- include('partials/footer') %>
