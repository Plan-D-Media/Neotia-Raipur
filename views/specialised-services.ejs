<%- include('partials/header', { 
    title: 'Specialised Woman & Child Care Services Raipur | Neotia Hospital',
    description: 'Expert medical care for women & children in Raipur. Services: Paediatrics, Gynaecology, IVF, NICU, Cardiac Science & Surgery. Book your appointment today.'
}) %>

<style>
/* Step indicator & Booking Form Styles */
.step-indicator {
    display: flex;
    align-items: center;
    margin-bottom: 1.5rem;
}
.step-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--grey-400);
}
.step-item.active { 
    color: var(--grey-800); 
    font-weight: 700; 
}
.step-item.done {
    color: var(--black);
}
.step-dot {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid var(--grey-300);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
}
.step-item.active .step-dot { 
    border-color: var(--theme-color, var(--brand-blue-1)); 
    color: var(--theme-color, var(--brand-blue-1)); 
}
.step-item.done .step-dot {
    border-color: var(--brand-blue-1);
    background: var(--brand-blue-1);
    color: var(--white);
}
.step-line {
    flex: 1;
    height: 1px;
    background: var(--grey-200);
    margin: 0 12px;
}
.submit-btn--outline {
    background: transparent;
    border: 2px solid currentColor;
    color: var(--grey-700);
}
.appoint {
    gap: 24px;
}
.booking-steps {
    width: 57%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: auto;
}
h2.step_heading {
    font-size: 18px;
    margin-bottom: 20px;
    color: var(--brand-blue-2-tint-1);
}
@media only screen and (min-width: 320px) and (max-width: 767px) {
    .booking-steps {
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        margin: auto;
    }
}
</style>

<!-- Request a Call Back Button -->
<a href="javascript:void(0)" class="callback-btn open_modal_callback" data-remote="/request-a-callback">
    Request a CallBack
</a>

<!-- Hero Banner -->
<section class="banner-sec">
    <div class="banner-area">
        <div class="container">
            <div class="row justify-content-center align-items-center">
                <div class="col-md-5 col-lg-5">
                    <h1 class="fadeInUp animatable">Specialised Clinical Services for Women &amp; Children</h1>
                    <p class="fadeInUp animatable">Comprehensive paediatric and maternal superspecialities backed by round-the-clock emergency care, advanced diagnostics, and dedicated clinical teams.</p>
                    <a href="#book_sectio" class="book-app fadeInUp animatable">Book Appointment</a>
                </div>
                <div class="col-md-6 col-lg-6">
                    <div class="banner-img text-center">
                        <img src="/img/cute_boy_doctor_banner.jpg" alt="Specialised Clinical Services - Little Doctor" class="img-fluid" style="max-height: 460px; width: auto; max-width: 100%; object-fit: cover; border-radius: 20px; box-shadow: 0 15px 35px rgba(var(--brand-blue-2-rgb), 0.12);">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- banner sec end -->

<!-- Content Tabs Section -->
<section id="specalities2" class="about-tab-section section-padding position-relative">
    <%- include('partials/speciality-tabs', { animClass: 'animated' }) %>
</section>
<!-- content tabs sec end -->

<!-- Appointment Form Sec start -->
<section class="app-sec p-bottom" id="book_sectio">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="mb-4 text-center fade-up animatable">
                    <h2 class="step_heading">Book Your Appointment</h2>
                </div>

                <!-- Step Progress -->
                <div class="booking-steps fade-up animatable">
                    <div class="step-indicator">
                        <div class="step-item active" id="step-indicator-1">
                            <div class="step-dot">1</div>
                            <span>Your details</span>
                        </div>
                        <div class="step-line"></div>
                        <div class="step-item" id="step-indicator-2">
                            <div class="step-dot">2</div>
                            <span>Appointment details</span>
                        </div>
                    </div>
                </div>

                <div class="booking-form fade-up animatable">
                    <div id="mess_appointment"></div>
                    <div id="loading_appointment_img" style="display:none;" class="text-center py-2 text-primary">
                        <i class="fa fa-spinner fa-spin"></i> Please wait..
                    </div>

                    <!-- Step 1: Patient basics -->
                    <div class="booking-step" id="booking-step-1">
                        <form class="appointment-form fadeInUp animated" name="book-appointment-form-step-1" id="book-appointment-form-step-1" method="post">
                            <div class="row">
                                <div class="col-lg-6 mb-3">
                                    <input type="text" class="form-control" placeholder="Patient Name" name="fname" id="fname" required>
                                </div>
                                <div class="col-lg-6 mb-3">
                                    <input type="tel" class="form-control" placeholder="Mobile" inputmode="numeric" pattern="[0-9]*" name="mobile" id="mobile" required>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-12 text-end">
                                    <input type="hidden" name="hlink" value="/specialised-services" />
                                    <input type="hidden" name="ip" value="127.0.0.1" />
                                    <input name="step" type="hidden" value="1">
                                    <input name="getanappointment" type="hidden" value="1">
                                    <input type="hidden" name="recaptcha_response" id="recaptchaResponse" value="dummy_ok">
                                    <button type="submit" id="appointsubmitTriger" class="submit-btn">Next &rarr;</button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Step 2: Appointment details -->
                    <div class="booking-step" id="booking-step-2" style="display:none;">
                        <form class="appointment-form fadeInUp animated" name="book-appointment-form-step-2" id="book-appointment-form-step-2" method="post">
                            <div class="row">
                                <div class="col-lg-6 mb-3">
                                    <input type="email" class="form-control" placeholder="Email Id" name="email" id="email" required>
                                    
                                    <select class="form-select select_department mt-3" name="department" id="department" data-target="#consultant" required>
                                        <option value="">Select Speciality</option>
                                        <% departments.forEach(dept => { %>
                                            <option value="<%= dept.id %>##<%= dept.name %>"><%= dept.name %></option>
                                        <% }); %>
                                    </select>
                                </div>

                                <div class="col-lg-6 mb-3">
                                    <select class="form-select" name="consultant" id="consultant" required>
                                        <option value="">Select Doctor</option>
                                        <option value="Any Doctor">Any Doctor</option>
                                        <% doctors.forEach(doc => { %>
                                            <option value="<%= doc.id %>##<%= doc.name %>" data-department="<%= doc.speciality %>"><%= doc.name %> (<%= doc.speciality %>)</option>
                                        <% }); %>
                                    </select>

                                    <div class="date-wrapper position-relative mt-3">
                                        <input type="date" class="form-control" placeholder="Date" name="preffered_date" id="preffered_date" required>
                                        <span class="calendar-icon"><i class="fa-solid fa-calendar-days"></i></span>
                                    </div>

                                    <input type="hidden" name="hospital_center" class="form-control readonly-field" value="<%= siteInfo.hospitalCentre %>" readonly>
                                </div>
                            </div>

                            <div class="row mt-2">
                                <div class="col-12 d-flex justify-content-between appoint">
                                    <button type="button" class="submit-btn submit-btn--outline" id="step2-back-btn">&larr; Back</button>
                                    <input name="step" type="hidden" value="2">
                                    <input name="getanappointment" type="hidden" value="1">
                                    <button type="submit" id="appointsubmitTriger_2" class="submit-btn">Submit Request</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- form sec end -->

<script>
// Mock reCAPTCHA fallback if blocked
if (typeof grecaptcha === 'undefined') {
    window.grecaptcha = {
        ready: function (cb) { cb(); },
        execute: function () { return Promise.resolve('dummy_recaptcha_ok'); }
    };
}

// Step 2 Back Button and Date Picker Init
document.addEventListener("DOMContentLoaded", function () {
    var backBtn = document.getElementById("step2-back-btn");
    if (backBtn) {
        backBtn.addEventListener("click", function () {
            document.getElementById("booking-step-2").style.display = "none";
            document.getElementById("booking-step-1").style.display = "block";
            var ind1 = document.getElementById("step-indicator-1");
            var ind2 = document.getElementById("step-indicator-2");
            ind1.classList.add("active");
            ind1.classList.remove("done");
            ind1.querySelector(".step-dot").innerHTML = "1";
            ind2.classList.remove("active");
        });
    }

    var today = new Date().toISOString().split('T')[0];
    var dateInput = document.getElementById("preffered_date");
    if (dateInput) {
        dateInput.setAttribute('min', today);
    }
});
</script>

<%- include('partials/modals') %>
<%- include('partials/footer') %>
