<%- include('partials/header', { 
    title: (typeof page !== 'undefined' && page && page.seoTitle) ? page.seoTitle : 'Frequently Asked Questions (FAQ) | Neotia Bhagirathi Hospital',
    description: (typeof page !== 'undefined' && page && page.metaDescription) ? page.metaDescription : 'Find answers to common questions about appointments, OPD timings, visiting hours, emergency services, and insurance at Neotia Bhagirathi Raipur.'
}) %>

<!-- Banner -->
<section class="banner-sec position-relative" style="background: linear-gradient(135deg, var(--brand-blue-2) 0%, var(--brand-blue-2-tint-1) 100%); padding: 120px 0 60px; color: var(--white);">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb" style="background: transparent; padding: 0;">
                        <li class="breadcrumb-item"><a href="/" style="color: var(--white); text-decoration: none;">Home</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">FAQ</li>
                    </ol>
                </nav>
                <h1 style="font-size: 38px; font-weight: 700; color: var(--white); margin-bottom: 12px;"><%= (typeof page !== 'undefined' && page && page.heading) ? page.heading : 'Frequently Asked Questions' %></h1>
                <p style="color: var(--white); font-size: 16px; max-width: 650px;">
                    <%= (typeof page !== 'undefined' && page && page.subheading) ? page.subheading : 'Common questions regarding doctor consultations, admission procedures, emergency protocols, and cashless mediclaim assistance.' %>
                </p>
            </div>
        </div>
    </div>
</section>

<!-- FAQ Accordion Section -->
<section class="section-padding" style="background: var(--white);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="faq-container">
                    <% faqs.forEach((faq, index) => { %>
                        <div class="faq-item mb-3" style="border: 1px solid var(--grey-100); border-radius: 12px; overflow: hidden; background: var(--grey-bg);">
                            <div class="faq-question p-4 d-flex justify-content-between align-items-center" style="cursor: pointer; font-weight: 700; color: var(--brand-blue-2-tint-3); font-size: 17px;" data-bs-toggle="collapse" data-bs-target="#faq-ans-<%= index %>" aria-expanded="<%= index === 0 ? 'true' : 'false' %>">
                                <span><i class="far fa-question-circle text-primary me-2"></i> <%= faq.question %></span>
                                <i class="fas fa-chevron-down text-muted transition-arrow"></i>
                            </div>
                            <div id="faq-ans-<%= index %>" class="collapse <%= index === 0 ? 'show' : '' %> p-4 pt-0 border-top bg-white" style="color: var(--grey-700); font-size: 15px; line-height: 1.7;">
                                <div class="pt-3">
                                    <%= faq.answer %>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <div class="card border-0 shadow-sm p-4 mt-5 text-center" style="border-radius: 16px; background: var(--grey-bg);">
                    <h5 style="color: var(--theme-color); font-weight: 700; margin-bottom: 8px;">Have a Question Not Listed Here?</h5>
                    <p class="text-muted small mb-3">Our patient coordinator desk is happy to assist you 24 hours a day.</p>
                    <div>
                        <a href="tel:<%= siteInfo.emergencyNumbers[0].replace(/\s+/g, '') %>" class="btn btn-primary me-2" style="border-radius: 20px; font-weight: 700;">
                            Call Helpdesk: <%= siteInfo.emergencyNumbers[0] %>
                        </a>
                        <a href="/contact" class="btn btn-outline-primary" style="border-radius: 20px; font-weight: 700;">
                            Send an Enquiry
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('partials/modals') %>
<%- include('partials/footer') %>
