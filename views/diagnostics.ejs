                        <p class="fadeInUp animatable">CT &amp; MRI scans that look deeper to safeguard little lives.</p>
                    </div>
                    <div class="col-md-6 col-lg-6">
                        <div class="banner-img text-center">
                            <img src="/img/twelve_year_boy_mri_doctor_banner.jpg" alt="CT and MRI Scan Diagnostics - 12 Year Old Boy Doctor" class="img-fluid" style="max-height: 460px; width: auto; max-width: 100%; object-fit: cover; border-radius: 20px; box-shadow: 0 15px 35px rgba(var(--brand-blue-2-rgb), 0.12);">
                        </div>
