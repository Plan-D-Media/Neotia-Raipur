<!-- Modal Container for Doctor Booking Popups -->
<div class="modal fade" id="enquiryModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modal-body">
                <!-- Loaded dynamically -->
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Modal remote loading & Owl Carousel
    if (window.jQuery) {
        $(document).on('click', '.open_modal_enquiry', function() {
            var url = $(this).data('remote');
            $('#modal-body').html('<div class="text-center py-4"><i class="fa fa-spinner fa-spin fa-2x"></i></div>');
            $('#enquiryModal').modal('show');
            $.get(url, function(data) {
                $('#modal-body').html(data);
            }).fail(function() {
                $('#modal-body').html('<div class="alert alert-danger">Unable to load appointment form. Please try calling us directly.</div>');
            });
        });

        if ($('.doctors-area').length && $.fn.owlCarousel) {
            $('.doctors-area').owlCarousel({
                loop: false,
                margin: 20,
                nav: true,
                dots: false,
                responsive: {
                    0: { items: 1 },
                    600: { items: 2 },
                    1000: { items: 3 }
                }
            });
        }
        if ($('.sec00-doctorwp').length && $.fn.owlCarousel) {
            $('.sec00-doctorwp').owlCarousel({
                loop: false,
                margin: 20,
                nav: true,
                dots: false,
                responsive: {
                    0: { items: 1 },
                    600: { items: 2 },
                    1000: { items: 3 },
                    1200: { items: 4 }
                }
            });
        }
    }
});
</script>
