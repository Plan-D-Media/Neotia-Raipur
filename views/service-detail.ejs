<%- include('partials/header', { 
    title: department.name + ' in Raipur | Neotia Bhagirathi',
    description: department.metaDescription || ('Expert ' + department.name + ' at Neotia Bhagirathi Woman and Child Care Centre, Raipur.')
}) %>

<!-- Service Banner -->
<section class="banner-sec position-relative" style="background: linear-gradient(135deg, var(--brand-blue-2) 0%, var(--brand-blue-2-tint-1) 100%); padding: 120px 0 60px; color: var(--white);">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb" style="background: transparent; padding: 0;">
                        <li class="breadcrumb-item"><a href="/" style="color: var(--white); text-decoration: none;">Home</a></li>
                        <li class="breadcrumb-item"><a href="/specialised-services" style="color: var(--white); text-decoration: none;">Services</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page"><%= department.name %></li>
                    </ol>
                </nav>
                <h1 style="font-size: 38px; font-weight: 700; color: var(--white); margin-bottom: 12px;"><%= department.name %></h1>
                <%# Specialities added from the Raipur sitemap have no approved copy yet: name, a neutral line and the CTAs only %>
                <% if (department.copyPending) { %>
                <p style="color: var(--white); font-size: 16px; max-width: 650px;">Details for this speciality will be added soon.</p>
                <div class="mt-4 d-flex flex-wrap gap-3">
                    <a href="/book-an-appointment/<%= department.slug %>" class="btn btn-brand-primary">Book An Appointment</a>
                    <button type="button" class="btn btn-brand-secondary" data-callback-trigger>Request a Callback</button>
                </div>
                <% } else { %>
                <p style="color: var(--white); font-size: 16px; max-width: 650px;">
                    <%= department.metaDescription || 'Dedicated superspeciality care providing advanced treatment, diagnostic excellence, and child-centered medical management.' %>
                </p>
                <div class="mt-4 d-flex flex-wrap gap-3">
                    <a href="/book-an-appointment" class="btn" style="background: var(--snd-color); color: var(--brand-blue-2-tint-3); border-radius: 30px; font-weight: 700; padding: 12px 28px;">
                        <i class="fas fa-calendar-check me-2"></i> Book Consultation
                    </a>
                    <a href="tel:<%= siteInfo.emergencyNumbers[0].replace(/\s+/g, '') %>" class="btn btn-outline-light" style="border-radius: 30px; font-weight: 700; padding: 12px 24px;">
                        <i class="fas fa-phone-alt me-2"></i> Emergency: <%= siteInfo.emergencyNumbers[0] %>
                    </a>
                </div>
                <% } %>
            </div>
            <%# CMS pages rendered with this template have no department icon %>
            <% if (typeof department.icon === 'string' && department.icon) { %>
            <div class="col-lg-4 text-center mt-4 mt-lg-0">
                <div style="background: rgba(var(--white-rgb), 0.08); border-radius: 20px; padding: 25px; display: inline-block;">
                    <img src="<%= department.icon.startsWith('http') ? department.icon : (department.icon.startsWith('/') ? department.icon : '/' + department.icon) %>" alt="<%= department.name %>" style="width: 120px; height: 120px; object-fit: contain;" onerror="this.src='/img/cardio.png'">
                </div>
            </div>
            <% } %>
        </div>
    </div>
</section>

<% if (!department.copyPending) { %>
<!-- Content Tabs Section -->
<section class="content-tabs-sec section-padding" style="background: var(--white);">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <!-- Nav Tabs -->
                <ul class="nav nav-tabs border-bottom mb-4" id="serviceTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active font-weight-bold" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview" type="button" role="tab" style="font-size: 16px; font-weight: 700; padding: 12px 20px; color: var(--theme-color);">
                            Overview &amp; Highlights
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link font-weight-bold" id="conditions-tab" data-bs-toggle="tab" data-bs-target="#conditions" type="button" role="tab" style="font-size: 16px; font-weight: 700; padding: 12px 20px; color: var(--grey-600);">
                            Conditions Treated
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link font-weight-bold" id="facilities-tab" data-bs-toggle="tab" data-bs-target="#facilities" type="button" role="tab" style="font-size: 16px; font-weight: 700; padding: 12px 20px; color: var(--grey-600);">
                            Advanced Facilities
                        </button>
                    </li>
                </ul>

                <!-- Tab Contents -->
                <div class="tab-content" id="serviceTabContent">
                    <div class="tab-pane fade show active" id="overview" role="tabpanel" style="color: var(--grey-700); font-size: 15px; line-height: 1.8;">
                        <% if (department.overview && department.overview.length > 50) { %>
                            <%- department.overview %>
                        <% } else { %>
                            <h3 style="color: var(--theme-color); font-weight: 700; margin-bottom: 15px;">Clinical Excellence in <%= department.name %></h3>
                            <p>The Department of <%= department.name %> at Neotia Bhagirathi Woman and Child Care Centre, Raipur, delivers comprehensive, state-of-the-art care for children and young adults with acute and chronic medical conditions.</p>
                            <p>Equipped with modern diagnostic tools and backed by a multidisciplinary team of paediatric specialists, we provide personalized treatment plans tailored to each child's developmental and medical needs.</p>
                            <h4 class="mt-4 mb-3" style="color: var(--brand-blue-2-tint-3); font-weight: 700;">Key Clinical Highlights</h4>
                            <ul>
                                <li>Round-the-clock emergency care and dedicated paediatric intensive care unit (PICU/NICU)</li>
                                <li>State-of-the-art diagnostic imaging and pathology support</li>
                                <li>Comprehensive pre-operative, intra-operative, and post-operative monitoring</li>
                                <li>Compassionate, child-friendly healing environment designed to comfort parents and children</li>
                            </ul>
                        <% } %>
                    </div>

                    <div class="tab-pane fade" id="conditions" role="tabpanel" style="color: var(--grey-700); font-size: 15px; line-height: 1.8;">
                        <h3 style="color: var(--theme-color); font-weight: 700; margin-bottom: 15px;">Conditions We Diagnose &amp; Treat</h3>
                        <p>Our experienced clinicians manage a broad spectrum of paediatric disorders, including:</p>
                        <div class="row g-3 mt-2">
                            <div class="col-md-6">
                                <div class="p-3 rounded-3" style="background: var(--grey-bg); border: 1px solid var(--grey-100);">
                                    <h5 style="font-size: 16px; font-weight: 700; color: var(--brand-blue-2-tint-3);"><i class="fas fa-stethoscope text-primary me-2"></i> Congenital &amp; Hereditary Conditions</h5>
                                    <p class="small text-muted mb-0">Early detection and corrective management of structural and developmental anomalies.</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 rounded-3" style="background: var(--grey-bg); border: 1px solid var(--grey-100);">
                                    <h5 style="font-size: 16px; font-weight: 700; color: var(--brand-blue-2-tint-3);"><i class="fas fa-heartbeat text-danger me-2"></i> Acute Emergencies</h5>
                                    <p class="small text-muted mb-0">Prompt resuscitation, stabilization, and critical care monitoring for severe paediatric illnesses.</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 rounded-3" style="background: var(--grey-bg); border: 1px solid var(--grey-100);">
                                    <h5 style="font-size: 16px; font-weight: 700; color: var(--brand-blue-2-tint-3);"><i class="fas fa-notes-medical text-success me-2"></i> Chronic Disease Care</h5>
                                    <p class="small text-muted mb-0">Long-term therapeutic management, medication titration, and growth surveillance.</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 rounded-3" style="background: var(--grey-bg); border: 1px solid var(--grey-100);">
                                    <h5 style="font-size: 16px; font-weight: 700; color: var(--brand-blue-2-tint-3);"><i class="fas fa-shield-alt text-warning me-2"></i> Preventive Wellness</h5>
                                    <p class="small text-muted mb-0">Vaccination, nutritional guidance, developmental milestones screening, and counselling.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="facilities" role="tabpanel" style="color: var(--grey-700); font-size: 15px; line-height: 1.8;">
                        <h3 style="color: var(--theme-color); font-weight: 700; margin-bottom: 15px;">Advanced Medical Infrastructure</h3>
                        <p>Neotia Bhagirathi Hospital is equipped with cutting-edge medical infrastructure to support high-risk and complex cases:</p>
                        <ul class="list-unstyled mt-3">
                            <li class="mb-3 d-flex align-items-start gap-3">
                                <i class="fas fa-check-circle text-primary mt-1" style="font-size: 18px;"></i>
                                <div>
                                    <strong style="color: var(--brand-blue-2-tint-3);">Level III Neonatal Intensive Care Unit (NICU)</strong>
                                    <div class="text-muted small">Equipped with high-frequency ventilators, nitric oxide therapy, and advanced incubators.</div>
                                </div>
                            </li>
                            <li class="mb-3 d-flex align-items-start gap-3">
                                <i class="fas fa-check-circle text-primary mt-1" style="font-size: 18px;"></i>
                                <div>
                                    <strong style="color: var(--brand-blue-2-tint-3);">Dedicated Paediatric Cardiac Cath Lab</strong>
                                    <div class="text-muted small">Specialized imaging and catheterization suites for interventional pediatric procedures.</div>
                                </div>
                            </li>
                            <li class="mb-3 d-flex align-items-start gap-3">
                                <i class="fas fa-check-circle text-primary mt-1" style="font-size: 18px;"></i>
                                <div>
                                    <strong style="color: var(--brand-blue-2-tint-3);">High-Resolution Diagnostic Radiology (CT / MRI)</strong>
                                    <div class="text-muted small">Fast, child-friendly scanning protocols reducing sedation requirements.</div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4 mt-5 mt-lg-0">
                <div class="card border-0 shadow p-4 sticky-top" style="border-radius: 16px; top: 100px;">
                    <h4 style="color: var(--theme-color); font-weight: 700; font-size: 20px; margin-bottom: 15px;">
                        Consult a Specialist
                    </h4>
                    <p class="text-muted small mb-4">Book an appointment with our <%= department.name %> consultants.</p>
                    
                    <a href="/book-an-appointment" class="btn w-100 py-3 mb-3 font-weight-bold" style="background: var(--snd-color); color: var(--brand-blue-2-tint-3); border-radius: 30px; font-weight: 700;">
                        Book Appointment Now
                    </a>

                    <button type="button" class="btn btn-outline-primary w-100 py-2 mb-4" data-bs-toggle="modal" data-bs-target="#requestcallback" style="border-radius: 30px; font-weight: 700;">
                        Request Call Back
                    </button>

                    <div class="p-3 rounded-3" style="background: var(--grey-bg); border: 1px solid var(--grey-100);">
                        <span class="text-uppercase small fw-bold text-muted d-block mb-1">OPD Direct Contact</span>
                        <a href="tel:<%= siteInfo.opdEnquiriesNumber %>" style="color: var(--theme-color); font-weight: 700; text-decoration: none;">
                            <i class="fas fa-phone-alt me-1"></i> <%= siteInfo.opdEnquiriesNumber %>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<% } %>

<!-- Doctors in this Speciality -->
<% if (specialityDoctors && specialityDoctors.length > 0) { %>
<section class="doctors-sec section-padding" style="background: var(--grey-bg);">
    <div class="container">
        <div class="row mb-4">
            <div class="col-12">
                <span class="text-uppercase fw-bold" style="color: var(--brand-blue-1); letter-spacing: 1.5px; font-size: 13px;">Department Faculty</span>
                <h3 style="color: var(--theme-color); font-weight: 700; font-size: 28px;">Doctors in <%= department.name %></h3>
            </div>
        </div>
        <div class="row g-4">
            <% specialityDoctors.forEach(doc => { %>
                <div class="col-lg-3 col-md-6 col-sm-6">
                    <div class="card h-100 border-0 shadow-sm" style="border-radius: 16px; overflow: hidden; background: var(--white);">
                        <div class="text-center pt-3" style="background: var(--grey-bg); height: 200px; display: flex; align-items: flex-end; justify-content: center;">
                            <img src="<%= doc.image ? (doc.image.startsWith('http') ? doc.image : (doc.image.startsWith('/') ? doc.image : '/' + doc.image)) : '/img/about-img.png' %>" alt="<%= doc.name %>" style="max-height: 180px; object-fit: contain;" onerror="this.src='/img/about-img.png'">
                        </div>
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <h4 style="font-size: 17px; font-weight: 700; color: var(--brand-blue-2-tint-3); margin-bottom: 4px;">
                                    <a href="/doctor/<%= doc.slug %>" style="color: inherit; text-decoration: none;"><%= doc.name %></a>
                                </h4>
                                <p style="color: var(--theme-color); font-size: 13px; font-weight: 700; margin-bottom: 8px;"><%= doc.speciality %></p>
                                <p class="text-muted small mb-3"><%= doc.qualifications || 'Consultant Specialist' %></p>
                            </div>
                            <div class="pt-2 d-grid gap-2">
                                <a href="/doctor/<%= doc.slug %>" class="btn btn-outline-primary btn-sm" style="border-radius: 20px;">View Profile</a>
                                <a href="/book-an-appointment?doctor=<%= encodeURIComponent(doc.name) %>" class="btn btn-sm" style="background: var(--snd-color); color: var(--brand-blue-2-tint-3); border-radius: 20px; font-weight: 700;">Book OPD</a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<%- include('partials/modals') %>
<%- include('partials/footer') %>
