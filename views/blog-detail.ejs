<%- include('partials/header', { 
    title: blog.title + ' | Neotia Bhagirathi Hospital Blog',
    description: blog.excerpt || blog.title
}) %>

<!-- Banner -->
<section class="banner-sec position-relative" style="background: linear-gradient(135deg, var(--brand-blue-2) 0%, var(--brand-blue-2-tint-1) 100%); padding: 120px 0 60px; color: var(--white);">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-10">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb" style="background: transparent; padding: 0;">
                        <li class="breadcrumb-item"><a href="/" style="color: var(--white); text-decoration: none;">Home</a></li>
                        <li class="breadcrumb-item"><a href="/blog" style="color: var(--white); text-decoration: none;">Blog</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Article</li>
                    </ol>
                </nav>
                <h1 style="font-size: 36px; font-weight: 700; color: var(--white); margin-bottom: 12px; line-height: 1.3;"><%= blog.title %></h1>
                <p style="color: var(--white); font-size: 15px;">
                    <i class="fas fa-calendar-alt me-2 text-warning"></i> Published on <%= blog.date %> | Medical Team, Neotia Bhagirathi New Town
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Blog Content -->
<section class="section-padding" style="background: var(--white);">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <article class="pe-lg-4">
                    <% if (blog.image) { %>
                        <div class="mb-4 rounded-4 overflow-hidden shadow-sm" style="max-height: 420px;">
                            <img src="<%= blog.image.startsWith('http') ? blog.image : (blog.image.startsWith('/') ? blog.image : '/' + blog.image) %>" alt="<%= blog.title %>" class="w-100 h-100" style="object-fit: cover;" onerror="this.src='/img/about-img.png'">
                        </div>
                    <% } %>

                    <div class="article-body" style="color: var(--brand-blue-2-tint-3); font-size: 16px; line-height: 1.85;">
                        <% if (blog.content && blog.content.length > 50) { %>
                            <%- blog.content %>
                        <% } else { %>
                            <p class="lead" style="color: var(--brand-blue-2-tint-3); font-weight: 400;"><%= blog.excerpt %></p>
                            <p>High-quality medical care during infancy and childhood is critical for lifelong wellness and development. At Neotia Bhagirathi Woman and Child Care Centre, our paediatric teams bring specialized clinical expertise to diagnose early warning signs and provide timely interventions.</p>
                            <h3 class="mt-4 mb-3" style="color: var(--theme-color); font-weight: 700;">When to Seek Specialist Advice</h3>
                            <p>Parents should never ignore persistent symptoms such as high fever resistant to medication, unusual lethargy, respiratory difficulties, poor feeding, or digestive discomfort in children. Early diagnosis in a dedicated paediatric facility ensures timely recovery and prevents complications.</p>
                            <h3 class="mt-4 mb-3" style="color: var(--theme-color); font-weight: 700;">Our Specialized Care Capabilities</h3>
                            <p>With round-the-clock emergency support, state-of-the-art Level-III NICU facilities, pediatric cardiology, and pediatric surgery, our doctors work as a cohesive unit to provide individualized care tailored to each child's needs.</p>
                        <% } %>
                    </div>

                    <div class="mt-5 pt-4 border-top d-flex justify-content-between align-items-center">
                        <a href="/blog" class="btn btn-outline-secondary" style="border-radius: 20px;">
                            <i class="fas fa-arrow-left me-1"></i> Back to All Articles
                        </a>
                        <a href="/book-an-appointment" class="btn" style="background: var(--snd-color); color: var(--brand-blue-2-tint-3); border-radius: 20px; font-weight: 700;">
                            Consult Our Doctors
                        </a>
                    </div>
                </article>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4 mt-5 mt-lg-0">
                <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 16px; background: var(--grey-bg);">
                    <h5 style="color: var(--theme-color); font-weight: 700; margin-bottom: 15px;">Recent Articles</h5>
                    <ul class="list-unstyled mb-0">
                        <% recentBlogs.forEach(rb => { %>
                            <li class="mb-3 pb-3 border-bottom">
                                <a href="/blog-details/<%= rb.slug %>" style="color: var(--brand-blue-2-tint-3); font-weight: 700; font-size: 14px; text-decoration: none; display: block; line-height: 1.4;">
                                    <%= rb.title %>
                                </a>
                                <small class="text-muted"><i class="far fa-clock me-1"></i> <%= rb.date %></small>
                            </li>
                        <% }); %>
                    </ul>
                </div>

                <div class="card border-0 shadow-sm p-4 text-center" style="border-radius: 16px; background: var(--brand-blue-2); color: var(--white);">
                    <h5 class="text-white font-weight-bold mb-2">Need Expert Medical Guidance?</h5>
                    <p class="text-white-50 small mb-4">Our paediatric and maternal care specialists are here to answer your questions.</p>
                    <a href="/book-an-appointment" class="btn w-100 font-weight-bold" style="background: var(--snd-color); color: var(--brand-blue-2-tint-3); border-radius: 25px; padding: 10px;">
                        Book Consultation
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('partials/modals') %>
<%- include('partials/footer') %>
