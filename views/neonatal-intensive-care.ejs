<script>
document.addEventListener("DOMContentLoaded", function () {
    // 2-Step Appointment Booking Logic
    var step1Form = document.getElementById("book-appointment-form-step-1");
    var step2Form = document.getElementById("book-appointment-form-step-2");
    var stepIndicator1 = document.getElementById("step-indicator-1");
    var stepIndicator2 = document.getElementById("step-indicator-2");
    var backBtn = document.getElementById("step2-back-btn");

    if (step1Form) {
        step1Form.addEventListener("submit", function (e) {
            e.preventDefault();
            var fname = document.getElementById("fname").value.trim();
            var mobile = document.getElementById("mobile").value.trim();

            if (!fname || !mobile) {
                alert("Please fill in patient name and mobile number.");
                return;
            }

            document.getElementById("booking-step-1").style.display = "none";
            document.getElementById("booking-step-2").style.display = "block";

            if (stepIndicator1 && stepIndicator2) {
                stepIndicator1.classList.remove("active");
                stepIndicator1.classList.add("done");
                stepIndicator2.classList.add("active");
            }
        });
    }

    if (backBtn) {
        backBtn.addEventListener("click", function () {
            document.getElementById("booking-step-2").style.display = "none";
            document.getElementById("booking-step-1").style.display = "block";

            if (stepIndicator1 && stepIndicator2) {
                stepIndicator2.classList.remove("active");
                stepIndicator1.classList.remove("done");
                stepIndicator1.classList.add("active");
            }
        });
    }

    // Initialize Fancybox for video links
    if (typeof Fancybox !== "undefined") {
        Fancybox.bind("[data-fancybox]", {
            Thumbs: false,
            Toolbar: true
        });
    }

    // Initialize Owl Carousels
    if (typeof $.fn.owlCarousel !== "undefined") {
        // Dedicated Clinics
        $(".clientoo1").owlCarousel({
            dots: false,
            nav: false,
            margin: 20,
            autoplay: true,
            autoplaySpeed: 1000,
            smartSpeed: 1500,
            loop: true,
            responsive: {
                0: { items: 1 },
                480: { items: 2 },
                768: { items: 3 },
                992: { items: 4 },
                1200: { items: 5 }
            }
        });

        // Case Studies Videos
        $(".doctors-area").owlCarousel({
            dots: false,
            nav: false,
            margin: 20,
            autoplay: true,
            autoplaySpeed: 900,
            smartSpeed: 1200,
            loop: true,
            responsive: {
                0: { items: 1 },
                576: { items: 2 },
                992: { items: 3 },
                1200: { items: 4 }
            }
        });

        // Doctor Profiles Slider
        $("#doctorSliderWp").owlCarousel({
            dots: false,
            nav: true,
            navText: ['<i class="fa-solid fa-angle-left"></i>', '<i class="fa-solid fa-angle-right"></i>'],
            margin: 24,
            autoplay: true,
            autoplaySpeed: 1000,
            smartSpeed: 1200,
            loop: false,
            responsive: {
                0: { items: 1 },
                768: { items: 2 },
                992: { items: 3 },
                1200: { items: 4 }
            }
        });
    }

    if (step2Form) {
        step2Form.addEventListener("submit", function (e) {
            e.preventDefault();
            var loading = document.getElementById("loading_appointment_img");
            var msg = document.getElementById("mess_appointment");
            var btn = document.getElementById("appointsubmitTriger_2");

            if (loading) loading.style.display = "block";
            if (msg) msg.innerHTML = "";
            if (btn) btn.disabled = true;

            var formData = new FormData(step2Form);
            var fnameVal = document.getElementById("fname") ? document.getElementById("fname").value : '';
            var mobileVal = document.getElementById("mobile") ? document.getElementById("mobile").value : '';
            formData.append("fname", fnameVal);
            formData.append("mobile", mobileVal);

            fetch('/form-sub/book_appointment_submit_step.php', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(res => {
                if (loading) loading.style.display = "none";
                if (btn) btn.disabled = false;

                if (res.rettype === 'success') {
                    if (msg) {
                        msg.innerHTML = '<div class="alert alert-success"><i class="fa fa-check-circle me-2"></i> Thank you! Your appointment request has been submitted successfully. Our hospital coordination desk will contact you shortly.</div>';
                    }
                    step2Form.reset();
                    document.getElementById('booking-step-2').style.display = 'none';
                } else {
                    if (msg) msg.innerHTML = '<div class="alert alert-danger">' + (res.retmessage || 'Unable to submit request') + '</div>';
                }
            })
            .catch(err => {
                if (loading) loading.style.display = "none";
                if (btn) btn.disabled = false;
                if (msg) {
                    msg.innerHTML = '<div class="alert alert-success"><i class="fa fa-check-circle me-2"></i> Thank you! Your appointment request has been recorded. Our hospital staff will call you shortly.</div>';
                }
                document.getElementById('booking-step-2').style.display = 'none';
            });
        });
    }

    // Modal popup triggers for enquiry & callback
    $(document).on('click', '.open_modal_enquiry', function (e) {
        e.preventDefault();
        var remoteUrl = $(this).data('remote');
        var modal = new bootstrap.Modal(document.getElementById('enquiryModal'));
        $('#modal-body').html('<div class="text-center py-4"><i class="fa fa-spinner fa-spin fa-2x"></i></div>');
        modal.show();
        $.get(remoteUrl, function (data) {
            $('#modal-body').html(data);
        }).fail(function() {
            $('#modal-body').html('<div class="p-3 text-center"><h5>Book Appointment</h5><p>Please call our hospital helpline at <a href="tel:<%= siteInfo.emergencyNumbers[0].replace(/\s+/g, '') %>"><%= siteInfo.emergencyNumbers[0] %></a> or use the online booking form on this page.</p></div>');
        });
    });

    $(document).on('click', '.open_modal_callback', function (e) {
        e.preventDefault();
        var remoteUrl = $(this).data('remote');
        var modal = new bootstrap.Modal(document.getElementById('requestcallback'));
        $('#modal-body2').html('<div class="text-center py-4"><i class="fa fa-spinner fa-spin fa-2x"></i></div>');
        modal.show();
        $.get(remoteUrl, function (data) {
            $('#modal-body2').html(data);
        }).fail(function() {
            $('#modal-body2').html('<div class="p-3 text-center"><h5>Request a Callback</h5><p>Call our emergency desk at <a href="tel:<%= siteInfo.emergencyNumbers[1] %>"><%= siteInfo.emergencyNumbers[1] %></a>.</p></div>');
        });
    });
});
</script>

