<style>
/* Step Indicator & Appointment Form Styles */
.step-dot {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid var(--grey-300);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
}
.step-item.active .step-dot { 
    border-color: var(--brand-blue-1); 
    color: var(--snd-color, var(--brand-orange)); 
}
.step-item.done .step-dot {
    border-color: var(--brand-blue-1);
    background: var(--brand-blue-1);
    color: var(--white);
}
.step-line {
    flex: 1;
    height: 1px;
    background: var(--grey-200);
    margin: 0 12px;
}
.submit-btn--outline {
    background: transparent;
    border: 2px solid currentColor;
    color: var(--grey-700);
}
.appoint {
    gap: 24px;
}
.booking-steps {
    width: 57%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 0 auto 25px;
}
.step-indicator {
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.step-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--grey-400);
}
.step-item.active {
    color: var(--grey-800);
    font-weight: 700;
}
.step-item.done {
    color: var(--black);
}

@media only screen and (min-width: 320px) and (max-width: 767px) {
    .booking-steps {
        width: 100%;
    }
}

/* Banner image styling */
.banner-sec {
    background: var(--grey-bg);
    padding-top: 170px !important;
    padding-bottom: 55px !important;
    position: relative;
}
@media (max-width: 991px) {
    .banner-sec {
        padding-top: 105px !important;
        padding-bottom: 40px !important;
    }
}
.banner-area .banner-img img {
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(var(--brand-blue-1-rgb), 0.12);
    width: 100%;
    max-height: 440px;
    object-fit: cover;
}

/* Speciality banner in content */
.speciality_banner_no {
    list-style: none !important;
    padding: 0 !important;
    margin: 30px 0 !important;
    text-align: center;
    grid-column: 1 / -1;
}
.speciality_banner_no img {
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(var(--black-rgb), 0.06);
    max-width: 100%;
}

/* Dedicated Clinic Slider */
.cli001-item {
    background: var(--white);
    padding: 24px 16px;
    text-align: center;
    border: 1px solid var(--grey-100);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    min-height: 230px;
    position: relative;
    transition: all 0.3s ease-in-out;
    box-shadow: 0 2px 8px rgba(var(--black-rgb), 0.04);
}
.cli001-item:hover {
    background-color: var(--brand-blue-2-tint-3);
    color: var(--white) !important;
    border-color: var(--snd-color, var(--brand-orange));
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(var(--brand-orange-rgb), 0.25);
}
.cli001-item:hover .clients-icon {
    background-color: var(--white);
}
.cli001-item:hover .clients-icon svg path {
    stroke: var(--snd-color, var(--brand-orange));
}
.cli001-item:hover .cli-title {
    color: var(--white) !important;
}
.cli001-item::after {
    content: "";
    position: absolute;
    bottom: 0;
    height: 3px;
    width: 60px;
    background-color: var(--snd-color, var(--brand-orange));
    transform: translateX(-50%);
    left: 50%;
    border-radius: 2px;
}
.clients-icon {
    width: 86px;
    height: 86px;
    background: var(--theme-color, var(--brand-blue-1));
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: all 0.3s ease;
}
.cli-title {
    font-size: 15px;
    font-weight: 400;
    color: var(--brand-blue-2-tint-3);
    line-height: 1.4;
    padding: 0 8px;
    transition: color 0.3s ease;
}

/* Case studies video items */
.doctors-item {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
}
.doctors-item img {
    border-radius: 12px;
    transition: transform 0.4s ease;
}
.doctors-item:hover img {
    transform: scale(1.03);
}
.right-plus {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 38px;
    height: 38px;
    background: rgba(var(--brand-orange-rgb), 0.95);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 10px rgba(var(--black-rgb), 0.25);
    transition: transform 0.3s ease;
}
.doctors-item:hover .right-plus {
    transform: scale(1.12);
}
.right-plus img {
    width: 18px;
    height: 18px;
}
</style>

