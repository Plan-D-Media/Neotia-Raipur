<!-- content tabs sec start -->
<section class="content-tabs-sec section-padding">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="panels">
                    <section id="tab1" class="panel active fade-in" role="tabpanel" aria-labelledby="t1">
                        <h3 class="fadeInUp animatable">Neonatal Intensive Care Unit (NICU)</h3>
                        <p class="fadeInUp animatable">Our Neonatal Intensive Care Unit (NICU) provides the highest level of comprehensive care for newborns requiring immediate and intensive support. Staffed by expert neonatologists, neonatal nurses and a multidisciplinary team, we are equipped with cutting-edge technology to manage the most complex conditions in premature infants and full-term babies with critical illnesses.</p>
                        <p class="pt-4 fadeInUp animatable">Our Specialised Services include:</p>

                        <div class="workup-sec mt-5">
                            <!-- Advanced Respiratory and Life Support -->
                            <h4 class="py-3 fadeInUp animatable">Advanced Respiratory and Life Support</h4>
                            <ul class="listing-apps">
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Mechanical Ventilation and High-Frequency Ventilation (HFV)</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>Providing precise, tailored breathing support for infants with immature lungs or severe respiratory distress (e.g., Respiratory Distress Syndrome - RDS).</p>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>Non-Invasive Ventilation: </strong>Utilising Continuous Positive Airway Pressure (CPAP) or Nasal Intermittent Positive Pressure Ventilation (NIPPV) to support breathing without an invasive tube.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div>
                                        <h5>Inhaled Nitric Oxide (iNO) Therapy</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>Administering a gas that helps relax blood vessels in the lungs, used primarily to treat Persistent Pulmonary Hypertension of the Newborn (PPHN).</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Extracorporeal Membrane Oxygenation (ECMO)</h5>
                                    </div>
                                    <p>A life-saving technology that temporarily acts as the baby's heart and lungs, used for severe cardiac or respiratory failure that doesn't respond to conventional ventilation.</p>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Surfactant Administration</h5>
                                    </div>
                                    <p>Targeted delivery of lung-coating substance to infants with RDS to help keep the tiny air sacs (alveoli) open.</p>
                                </li>
                            </ul>

                            <!-- Neuro-Critical and Developmental Care -->
                            <h4 class="py-3 mt-4 fadeInUp animatable">Neuro-Critical and Developmental Care</h4>
                            <ul class="listing-apps">
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Therapeutic Hypothermia (Cooling Therapy)</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>Controlled cooling of a newborn's body temperature for 72 hours to reduce the risk of brain damage following a lack of oxygen at birth (Hypoxic-Ischaemic Encephalopathy - HIE).</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div>
                                        <h5>Continuous EEG Monitoring</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>Monitoring the brain’s electrical activity to detect and treat subtle seizures in critically ill newborns.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Neurodevelopmental Follow-Up Programme</h5>
                                    </div>
                                    <p>Long-term assessment and intervention by developmental paediatricians, physiotherapists and occupational therapists for all NICU graduates, especially those born extremely prematurely.</p>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Kangaroo Care and Developmental Support</h5>
                                    </div>
                                    <p>Encouraging skin-to-skin contact and a quiet, dark environment to promote bonding, temperature regulation and optimal brain development.</p>
                                </li>
                            </ul>

                            <!-- Medical and Surgical Care -->
                            <h4 class="py-3 mt-4 fadeInUp animatable">Medical and Surgical Care</h4>
                            <ul class="listing-apps">
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Neonatal Cardiology</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>Advanced monitoring, medication and, in collaboration with paediatric cardiology, interventions for congenital heart defects, including pre-operative and post-operative care.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Neonatal Surgery Support</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>Immediate, integrated care for babies requiring surgery for congenital anomalies such as Oesophageal Atresia, Congenital Diaphragmatic Hernia (CDH), Gastroschisis and Necrotising Enterocolitis (NEC).</p>
                                        <p>Post-operative intensive monitoring and pain management.</p>
                                    </div>
                                </li>

                                <!-- Speciality Banner -->
                                <li class="fadeInUp animatable speciality_banner_no">
                                    <img class="img-fluid speciality_banner" src="/upload/fileManager/specialise_banner/NeonatalIntensiveCareUnit.png" alt="Neonatal Intensive Care Unit (NICU)" />
                                </li>

                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Nutrition and Growth Support</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>Total Parenteral Nutrition (TPN): </strong>Delivering all necessary nutrients directly into the bloodstream for infants who cannot tolerate gut feeding.</p>
                                        <p><strong>Human Milk Fortification: </strong>Specialised preparation of breast milk to meet the high caloric and protein needs of premature infants.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Infection Management</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>Rapid diagnosis and targeted antibiotic therapy for Neonatal Sepsis and other infections.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Jaundice and Phototherapy</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>Intensive monitoring and treatment for severe jaundice (hyperbilirubinemia), including specialised phototherapy and, when necessary, exchange transfusions.</p>
                                    </div>
                                </li>
                            </ul>

                            <!-- Family-Centred Care -->
                            <h4 class="py-3 mt-4 fadeInUp animatable">Family-Centred Care</h4>
                            <ul class="listing-apps">
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Parental Education and Support</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>Providing continuous updates, training on infant care procedures (like tube feeding or monitoring) and emotional support to families navigating the critical care environment.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Lactation and Breastfeeding Support</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>Dedicated lactation consultants to assist mothers in establishing and maintaining milk supply while their baby is in the NICU.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Coordinated Discharge Planning</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p>Seamless transition of care from the intensive setting to the home environment, including arranging necessary home equipment, follow-up appointments and community resources.</p>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- content tabs sec end -->

