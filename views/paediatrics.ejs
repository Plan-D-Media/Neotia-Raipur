<script>
document.addEventListener('DOMContentLoaded', function() {
    // 2-Step Appointment Form Logic
    const step1Form = document.getElementById('appointmentFormStep1');
    const step2Form = document.getElementById('appointmentFormStep2');
    const step1Div = document.getElementById('appointment_step_1');
    const step2Div = document.getElementById('appointment_step_2');
    const nextBtn = document.getElementById('appointsubmitTriger_1');
    const prevBtn = document.getElementById('appointPrevTriger_2');
    const ind1 = document.getElementById('step_indicator_1');
    const ind2 = document.getElementById('step_indicator_2');

    if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
            e.preventDefault();
            const fname = document.getElementById('fname') ? document.getElementById('fname').value.trim() : '';
            const mobile = document.getElementById('mobile') ? document.getElementById('mobile').value.trim() : '';
            const email = document.getElementById('email') ? document.getElementById('email').value.trim() : '';
            
            if (!fname) {
                alert('Please enter your full name.');
                return;
            }
            if (!mobile || !/^\d{10}$/.test(mobile.replace(/\D/g, ''))) {
                alert('Please enter a valid 10-digit mobile number.');
                return;
            }
            
            if (step1Div) step1Div.style.display = 'none';
            if (step2Div) step2Div.style.display = 'block';
            if (ind1) {
                ind1.classList.remove('active');
                ind1.classList.add('done');
            }
            if (ind2) {
                ind2.classList.add('active');
            }
        });
    }

    if (prevBtn) {
        prevBtn.addEventListener('click', function() {
            if (step2Div) step2Div.style.display = 'none';
            if (step1Div) step1Div.style.display = 'block';
            if (ind2) ind2.classList.remove('active');
            if (ind1) {
                ind1.classList.remove('done');
                ind1.classList.add('active');
            }
        });
    }

    if (step2Form) {
        step2Form.addEventListener('submit', function(e) {
            e.preventDefault();
            const loading = document.getElementById('loading_appointment_img');
            const msg = document.getElementById('mess_appointment');
            
            const formData = {
                fname: document.getElementById('fname') ? document.getElementById('fname').value : '',
                mobile: document.getElementById('mobile') ? document.getElementById('mobile').value : '',
                email: document.getElementById('email') ? document.getElementById('email').value : '',
                department: document.getElementById('department') ? document.getElementById('department').value : "14##Paediatrics",
                consultant: document.getElementById('consultant') ? document.getElementById('consultant').value : '',
                preffered_date: document.getElementById('preffered_date') ? document.getElementById('preffered_date').value : '',
                hospital_center: 'NBWCCC, Raipur'
            };

            if (loading) loading.style.display = 'block';
            if (msg) msg.innerHTML = '';

            fetch('/form-sub/appointment_submit.php', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(formData)
            })
            .then(res => res.json())
            .then(data => {
                if (loading) loading.style.display = 'none';
                if (msg) {
                    msg.innerHTML = '<div class="alert alert-success">Thank you! Your appointment request has been submitted successfully.</div>';
                }
                step2Form.reset();
                if (step1Form) step1Form.reset();
                setTimeout(() => {
                    if (step2Div) step2Div.style.display = 'none';
                    if (step1Div) step1Div.style.display = 'block';
                    if (ind2) ind2.classList.remove('active');
                    if (ind1) {
                        ind1.classList.remove('done');
                        ind1.classList.add('active');
                    }
                }, 4000);
            })
            .catch(err => {
                if (loading) loading.style.display = 'none';
                if (msg) {
                    msg.innerHTML = '<div class="alert alert-success">Thank you! Your appointment request has been submitted.</div>';
                }
            });
        });
    }

    // Modal remote loading & Owl Carousel
    if (window.jQuery) {
        $(document).on('click', '.open_modal_enquiry', function() {
            var url = $(this).data('remote');
            $('#modal-body').html('<div class="text-center py-4"><i class="fa fa-spinner fa-spin fa-2x"></i></div>');
            $('#enquiryModal').modal('show');
            $.get(url, function(data) {
                $('#modal-body').html(data);
            }).fail(function() {
                $('#modal-body').html('<div class="alert alert-danger">Unable to load appointment form. Please try calling us directly.</div>');
            });
        });

        if ($('.doctors-area').length && $.fn.owlCarousel) {
            $('.doctors-area').owlCarousel({
                loop: false,
                margin: 20,
                nav: true,
                dots: false,
                responsive: {
                    0: { items: 1 },
                    600: { items: 2 },
                    1000: { items: 3 }
                }
            });
        }
        if ($('.sec00-doctorwp').length && $.fn.owlCarousel) {
            $('.sec00-doctorwp').owlCarousel({
                loop: false,
                margin: 20,
                nav: true,
                dots: false,
                responsive: {
                    0: { items: 1 },
                    600: { items: 2 },
                    1000: { items: 3 },
                    1200: { items: 4 }
                }
            });
        }
    }
});
</script>
