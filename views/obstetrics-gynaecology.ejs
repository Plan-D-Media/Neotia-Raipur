<script>
$(document).ready(function() {
    // Initialize Fancybox for video advice
    if (typeof Fancybox !== "undefined") {
        Fancybox.bind("[data-fancybox]", {
            Toolbar: true
        });
    }

    // Initialize Video Carousel
    if ($(".doctors-area").length) {
        $(".doctors-area").owlCarousel({
            loop: false,
            margin: 20,
            nav: true,
            dots: false,
            navText: ['<i class="fa-solid fa-angle-left"></i>', '<i class="fa-solid fa-angle-right"></i>'],
            responsive: {
                0: { items: 1 },
                768: { items: 2 },
                992: { items: 3 },
                1200: { items: 4 }
            }
        });
    }

    // Initialize Doctor Slider
    if ($('#doctorSliderWp').length) {
        $('#doctorSliderWp').owlCarousel({
            loop: false,
            margin: 20,
            nav: true,
            dots: false,
            navText: ['<i class="fa-solid fa-angle-left"></i>', '<i class="fa-solid fa-angle-right"></i>'],
            responsive: {
                0: { items: 1 },
                576: { items: 1 },
                768: { items: 2 },
                992: { items: 3 },
                1200: { items: 4 }
            }
        });
    }

    // Two-step appointment form handling
    const step1Form = document.getElementById('book-appointment-form-step-1');
    const step2Form = document.getElementById('book-appointment-form-step-2');
    const step1Div = document.getElementById('booking-step-1');
    const step2Div = document.getElementById('booking-step-2');
    const ind1 = document.getElementById('step-indicator-1');
    const ind2 = document.getElementById('step-indicator-2');
    const prevBtn = document.getElementById('step2-prev-btn');

    if (step1Form) {
        step1Form.addEventListener('submit', function(e) {
            e.preventDefault();
            const name = document.getElementById('fname').value.trim();
            const mobile = document.getElementById('mobile').value.trim();

            if (!name || !mobile) {
                alert('Please enter patient name and mobile number.');
                return;
            }

            step1Div.style.display = 'none';
            step2Div.style.display = 'block';
            if (ind1) {
                ind1.classList.remove('active');
                ind1.classList.add('done');
            }
            if (ind2) {
                ind2.classList.add('active');
            }
        });
    }

    if (prevBtn) {
        prevBtn.addEventListener('click', function() {
            step2Div.style.display = 'none';
            step1Div.style.display = 'block';
            if (ind2) ind2.classList.remove('active');
            if (ind1) {
                ind1.classList.remove('done');
                ind1.classList.add('active');
            }
        });
    }

    if (step2Form) {
        step2Form.addEventListener('submit', function(e) {
            e.preventDefault();
            const loading = document.getElementById('loading_appointment_img');
            const msg = document.getElementById('mess_appointment');
            
            const formData = {
                fname: document.getElementById('fname') ? document.getElementById('fname').value : '',
                mobile: document.getElementById('mobile') ? document.getElementById('mobile').value : '',
                email: document.getElementById('email') ? document.getElementById('email').value : '',
                department: document.getElementById('department') ? document.getElementById('department').value : '9##Obstetrics and Gynaecology',
                consultant: document.getElementById('consultant') ? document.getElementById('consultant').value : '',
                preffered_date: document.getElementById('preffered_date') ? document.getElementById('preffered_date').value : '',
                hospital_center: '<%= siteInfo.hospitalCentre %>'
            };

            if (loading) loading.style.display = 'block';
            if (msg) msg.innerHTML = '';

            fetch('/form-sub/appointment_submit.php', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(formData)
            })
            .then(res => res.json())
            .then(data => {
                if (loading) loading.style.display = 'none';
                if (msg) {
                    msg.innerHTML = '<div class="alert alert-success">Thank you! Your appointment request has been submitted successfully.</div>';
                }
                step2Form.reset();
                if (step1Form) step1Form.reset();
                setTimeout(() => {
                    step2Div.style.display = 'none';
                    step1Div.style.display = 'block';
                    if (ind2) ind2.classList.remove('active');
                    if (ind1) {
                        ind1.classList.remove('done');
                        ind1.classList.add('active');
                    }
                }, 4000);
            })
            .catch(err => {
                if (loading) loading.style.display = 'none';
                if (msg) {
                    msg.innerHTML = '<div class="alert alert-success">Thank you! Your appointment request has been submitted.</div>';
                }
            });
        });
    }

    // Modal remote loading
    $(document).on('click', '.open_modal_enquiry', function() {
        var url = $(this).data('remote');
        $('#modal-body').html('<div class="text-center py-4"><i class="fa fa-spinner fa-spin fa-2x"></i></div>');
        $('#enquiryModal').modal('show');
        $.get(url, function(data) {
            $('#modal-body').html(data);
        }).fail(function() {
            $('#modal-body').html('<div class="alert alert-danger">Unable to load appointment form. Please try calling us directly.</div>');
        });
    });
});
</script>
