<%- include('partials/footer') %>

<script>
$(document).ready(function() {
    // Initialize Fancybox for video advice
    if (typeof Fancybox !== "undefined") {
        Fancybox.bind("[data-fancybox]", {
            Toolbar: true
        });
    }

    // Initialize Video Carousel
    if ($(".doctors-area").length) {
        $(".doctors-area").owlCarousel({
            loop: false,
            margin: 20,
            nav: true,
            dots: false,
            navText: ['<i class="fa-solid fa-angle-left"></i>', '<i class="fa-solid fa-angle-right"></i>'],
            responsive: {
                0: { items: 1 },
                768: { items: 2 },
                992: { items: 3 },
                1200: { items: 4 }
            }
        });
    }

    // Initialize Doctor Slider
    if ($('#doctorSliderWp').length) {
        $('#doctorSliderWp').owlCarousel({
            loop: false,
            margin: 20,
            nav: true,
            dots: false,
            navText: ['<i class="fa-solid fa-angle-left"></i>', '<i class="fa-solid fa-angle-right"></i>'],
            responsive: {
                0: { items: 1 },
                576: { items: 1 },
                768: { items: 2 },
                992: { items: 3 },
                1200: { items: 4 }
            }
        });
    }

    // Modal remote loading
    $(document).on('click', '.open_modal_enquiry', function() {
        var url = $(this).data('remote');
        $('#modal-body').html('<div class="text-center py-4"><i class="fa fa-spinner fa-spin fa-2x"></i></div>');
        $('#enquiryModal').modal('show');
        $.get(url, function(data) {
            $('#modal-body').html(data);
        }).fail(function() {
            $('#modal-body').html('<div class="alert alert-danger">Unable to load appointment form. Please try calling us directly.</div>');
        });
    });
});
</script>
