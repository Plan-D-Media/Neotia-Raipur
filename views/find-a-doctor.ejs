    <div class="banner-area">
        <img src="/img/bengali_doctor_girl_banner_desk.png" alt="Find a doctor banner" class="img-fluid home-banner-img dask-view">
        <img src="/img/bengali_doctor_girl_banner_mob.png" alt="Find a doctor banner" class="img-fluid home-banner-img mob-view">
        
        <div class="banner-overley">
            <div class="container">
