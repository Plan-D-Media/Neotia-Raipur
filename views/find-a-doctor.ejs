<%- include('partials/header', { 
    title: 'Find a Doctor | Specialist Doctors & Surgeons | Neotia Bhagirathi Raipur',
    description: 'Looking for top doctors in Raipur? Find expert Pediatricians, Gynecologists & more at Neotia Bhagirathi. View profiles & book',
    bodyClass: 'doctor-list-page'
}) %>

<link rel="stylesheet" href="/css/inner_style.css">

<style>
/* Transparent header sitting naturally over banner, matching live site */
/* Full Screen Banner Section with New Bengali Female Doctor + Cute Girl */
#doctor-list-banner.banner-sec {
    background-color: var(--grey-bg);
    padding-top: 0 !important;
    overflow: hidden;
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
}
#doctor-list-banner .banner-area {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
}
.home-banner-img.dask-view {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right bottom;
    z-index: 1;
}
.home-banner-img.mob-view {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    z-index: 1;
}
.banner-overley {
    position: relative;
    width: 100%;
    z-index: 5;
    padding-top: 60px;
}
.home-banner-text {
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
}
.home-banner-text h1 {
    font-size: 52px;
    font-weight: 700;
    color: var(--brand-blue-1);
    margin-bottom: 12px;
    letter-spacing: -0.5px;
}
/* The banner photo is pale: the shared white hero heading would vanish, so use Blue 2 here */
#doctor-list-banner .home-banner-text h1 {
    color: var(--brand-blue-2) !important;
    text-shadow: none !important;
}
#doctor-list-banner .home-banner-text p {
    font-size: 18px;
    color: var(--grey-700);
    font-weight: 400;
    margin-bottom: 28px;
}
.banner-form {
    display: flex;
    align-items: center;
    background: var(--white);
    border-radius: 40px;
    padding: 6px 10px;
    width: 680px;
    max-width: 95%;
    margin: auto;
    box-shadow: 0 4px 22px rgba(var(--black-rgb), 0.08);
    border: 1px solid rgba(var(--brand-blue-1-rgb), 0.12);
    z-index: 10;
    position: relative;
}
.banner-form input {
    flex: 1;
    border: none;
    outline: none;
    padding: 12px 22px;
    border-radius: 40px;
    font-size: 15px;
    color: var(--brand-blue-2-tint-3);
    background: transparent;
}
.banner-form input::placeholder {
    color: var(--brand-blue-2-tint-1);
    font-size: 15px;
}
.banner-form .srh-btn {
    background: var(--brand-orange);
    border: none;
    outline: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    margin-left: 8px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 10px rgba(var(--brand-orange-rgb), 0.3);
}
.banner-form .srh-btn:hover {
    background: var(--brand-orange);
    transform: scale(1.05);
    color: var(--brand-blue-2-tint-3);
}
.banner-form .srh-btn svg {
    fill: var(--white);
}

/* Trending & Suggestion Box */
.banner-main-form {
    position: relative;
}
.trending-box {
    display: none;
    position: absolute;
    background: var(--white);
    border-radius: 14px;
    padding: 18px 22px;
    width: 680px;
    max-width: 95%;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 10px;
    box-shadow: 0 12px 35px rgba(var(--black-rgb), 0.15);
    z-index: 100;
    text-align: left;
}
.trending-box h4 {
    font-size: 14px;
    color: var(--grey-600);
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 12px;
    letter-spacing: 0.5px;
}
.tag-details {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}
.tag-details span a {
    display: inline-block;
    background: var(--grey-bg);
    color: var(--brand-blue-2);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 400;
    text-decoration: none;
    transition: all 0.2s ease;
}
.tag-details span a:hover {
    background: var(--brand-blue-1);
    color: var(--white);
}

/* Floating Callback Button */
.callback-btn {
    position: fixed;
    right: 20px;
    top: 50%;
    transform: translateY(-50%) rotate(-90deg);
    transform-origin: right center;
    background-color: var(--brand-blue-1);
    color: var(--white) !important;
    padding: 10px 22px;
    font-size: 14px;
    font-weight: 700;
    border-radius: 8px 8px 0 0;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(var(--black-rgb), 0.2);
    z-index: 999;
    letter-spacing: 0.3px;
    transition: all 0.2s ease;
}
.callback-btn:hover {
    background-color: var(--brand-blue-2-tint-3);
    color: var(--white) !important;
}

/* Doctor Listing Section */
.doction-lise-sec {
    background: var(--grey-bg);
    padding: 60px 0 80px;
}
.doction-lise-sec .section-heading {
    font-size: 34px;
    font-weight: 700;
    color: var(--brand-blue-2);
    margin-bottom: 8px;
}
.doction-lise-sec p.section-subheading {
    color: var(--grey-600);
    font-size: 16px;
    margin-bottom: 25px;
}
.doction-lise-sec .sec001-item {
    margin: 0;
    margin-top: 30px;
    border-radius: 20px;
    overflow: hidden;
    background: var(--white);
    box-shadow: 0 4px 16px rgba(var(--black-rgb), 0.06);
    transition: 0.3s all ease-in;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: calc(100% - 30px);
    border: 1px solid var(--grey-100);
}
.doction-lise-sec .sec001-item:hover {
    box-shadow: 0 12px 28px rgba(var(--brand-blue-1-rgb), 0.16);
    transform: translateY(-5px);
}
.doction-lise-sec .sec001-item .img-doctor {
    position: relative;
    overflow: hidden;
    background: var(--grey-bg);
    text-align: center;
}
.doction-lise-sec .sec001-item .img-doctor img {
    width: 100%;
    height: 252px;
    object-fit: contain;
    object-position: bottom center;
    transform: scale(1);
    transition: 0.6s ease all;
    display: block;
    margin: 0 auto;
}
.doction-lise-sec .sec001-item:hover .img-doctor img {
    transform: scale(1.08);
}
.doction-lise-sec .doctor-name {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background: var(--brand-orange);
    padding: 10px 16px;
    clip-path: polygon(0 0, 80% 0, 90% 100%, 0% 100%);
    font-size: 16px;
    color: var(--brand-blue-2-tint-3);
    font-weight: 700;
    margin: 0;
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    z-index: 2;
}
/* Zen Maru Gothic runs wider than the old face: let long names wrap instead of cutting them off */
@media (max-width: 1199px) {
    .doction-lise-sec .doctor-name {
        white-space: normal;
        padding-right: 22%;
        line-height: 1.25;
    }
}
.doction-lise-sec .doctor-content {
    text-align: center;
    padding: 20px;
    border: 1px solid var(--grey-100);
    border-top: none;
    background: var(--white);
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    min-height: 230px;
}
.doction-lise-sec .doctor-content h5 {
    color: var(--brand-blue-2-tint-3);
    font-weight: 700;
    font-size: 17px;
    margin-bottom: 8px;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1.3;
}
.doction-lise-sec .doctor-content span.exp-badge {
    color: var(--brand-blue-1);
    margin-bottom: 8px;
    display: block;
    font-weight: 700;
    font-size: 14px;
}
.doction-lise-sec .doctor-content p {
    color: var(--grey-600);
    font-size: 13.5px;
    margin-bottom: 4px;
    line-height: 1.4;
}
.doction-lise-sec .doctor-content a.profile-link {
    font-size: 14px;
    display: inline-block;
    margin-top: 10px;
    text-decoration: none;
    font-weight: 700;
    color: var(--brand-blue-1);
    transition: color 0.2s ease;
}
.doction-lise-sec .doctor-content a.profile-link:hover {
    color: var(--brand-blue-1);
    text-decoration: underline;
}
.doction-lise-sec .sec001-item .book-app {
    display: block;
    width: 100%;
    background: var(--brand-blue-1);
    color: var(--white) !important;
    text-align: center;
    padding: 12px 20px;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    border: 1px solid var(--brand-blue-1);
    border-top: 0;
    transition: background 0.3s ease;
}
.doction-lise-sec .sec001-item .book-app:hover {
    background: var(--brand-blue-2);
    border-color: var(--brand-blue-2);
}

@media (max-width: 991px) {
    #doctor-list-banner.banner-sec,
    #doctor-list-banner .banner-area {
        min-height: 70vh;
    }
    .home-banner-img {
        object-position: 80% bottom;
    }
}
@media (max-width: 767px) {
    .dask-view { display: none !important; }
    .mob-view { display: block !important; }
    #doctor-list-banner.banner-sec,
    #doctor-list-banner .banner-area {
        min-height: 480px;
        height: auto;
        padding-top: 90px;
    }
    .home-banner-text h1 { font-size: 32px; }
    .callback-btn { display: none; }
}
@media (min-width: 768px) {
    .dask-view { display: block !important; }
    .mob-view { display: none !important; }
}
</style>

<!-- Floating Request a CallBack Button -->
<a href="javascript:void(0)" class="callback-btn open_modal_callback" data-bs-toggle="modal" data-bs-target="#requestcallback">Request a CallBack</a>

