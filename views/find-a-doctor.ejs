<!-- Doctor Listing Section -->
<section class="doction-lise-sec section-padding">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center mb-4">
                <h2 class="section-heading">Our Doctors</h2>
                <p class="section-subheading">Choose the speciality - Find &amp; select the doctor - Book an appointment</p>
                <% if (typeof query !== 'undefined' && (query.search || query.search_keyword || query.speciality)) { %>
                    <div class="mt-2">
                        <span class="badge bg-primary px-3 py-2" style="font-size: 13px;">
                            Filtering by: <%= query.search || query.search_keyword || query.speciality %>
                        </span>
                        <a href="/find-a-doctor" class="badge bg-secondary text-decoration-none px-3 py-2 ms-2" style="font-size: 13px;">Clear Filter</a>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="scroll scrollList" id="page_list_content">
            <div class="row" id="doctorItemsGrid">
                <% if (doctors && doctors.length > 0) { %>
                    <% doctors.forEach(function(doctor) { %>
                    <div class="col-md-6 col-lg-4 doctor-card-col mb-4" data-name="<%= doctor.name.toLowerCase() %>" data-speciality="<%= (doctor.speciality || '').toLowerCase() %>" data-qual="<%= (doctor.qualifications || doctor.qualification || '').toLowerCase() %>">
                        <div class="sec001-item fadeInUp">
                            <div class="img-doctor">
                                <img src="<%= doctor.image %>" alt="<%= doctor.name %>" loading="lazy" onerror="this.onerror=null; this.src='/upload/fileManager/test2/DrSanjiban-list.png';">
                                <h4 class="doctor-name"><%= doctor.name %></h4>
                            </div>
                            <div class="doctor-content">
                                <h5><%= doctor.speciality %></h5>
                                <% if (doctor.experience) { %>
                                    <span class="exp-badge"><%= doctor.experience %></span>
                                <% } else { %>
                                    <span class="exp-badge">15+ years experience</span>
                                <% } %>
                                <% if (doctor.qualifications || doctor.qualification) { %>
                                    <p><%= doctor.qualifications || doctor.qualification %></p>
                                <% } %>
                                <% if (doctor.regNo) { %>
                                    <p><%= doctor.regNo.startsWith('Reg') ? doctor.regNo : 'Reg. No. : ' + doctor.regNo %></p>
                                <% } %>
                                <% if (doctor.timing) { %>
                                    <p><%= doctor.timing %></p>
                                <% } %>
                                <a href="/doctor/<%= doctor.slug %>" class="profile-link">View Profile</a>
                            </div>
                            <a href="javascript:void(0)" class="book-app open_modal_enquiry" data-remote="/book-an-appointment-popup/<%= doctor.slug %>">Book Appointment</a>
                        </div>
                    </div>
                    <% }); %>
                <% } else { %>
                    <div class="col-12 text-center py-5">
                        <div class="alert alert-info py-4">
                            <h4>No Doctors Found</h4>
                            <p class="mb-3">We couldn't find any doctors matching your search query.</p>
                            <a href="/find-a-doctor" class="btn btn-primary" style="background: var(--brand-blue-1); border: none;">View All Doctors</a>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<!-- Modal Container for Doctor Booking Popups -->
<div class="modal fade" id="enquiryModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modal-body">
                <!-- Loaded dynamically -->
            </div>
        </div>
    </div>
</div>

<!-- Modal Container for Request Callback -->
<div class="modal fade" id="requestcallback" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title text-white">Request A Callback</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="callbackFormStatus"></div>
                <form id="callbackForm" method="POST" action="/form-sub/enquiry_submit.php">
                    <input type="hidden" name="source" value="Find a Doctor Callback Modal">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Your Name *</label>
                        <input type="text" class="form-control" name="name" required placeholder="Enter your full name">
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Phone Number *</label>
                        <input type="tel" class="form-control" name="phone" required pattern="[0-9]{10}" placeholder="Enter 10-digit mobile number">
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Department / Query</label>
                        <select class="form-select" name="department">
                            <option value="">Select Speciality</option>
                            <% departments.forEach(dept => { %>
                            <option value="<%= dept.name %>"><%= dept.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <button type="submit" id="btnSubmitCallback" class="btn btn-primary w-100 py-2" style="background: var(--brand-orange); border: none; font-weight: 700; color: var(--brand-blue-2-tint-3);">Request Callback Now</button>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('searchInput');
    const trendingBox = document.getElementById('trendingBox');
    const doctorCols = document.querySelectorAll('.doctor-card-col');

    if (searchInput) {
        // Show trending box on focus
        searchInput.addEventListener('focus', function() {
            if (trendingBox) trendingBox.style.display = 'block';
        });

        // Hide trending box when clicking outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('#searchInput, #trendingBox')) {
                if (trendingBox) trendingBox.style.display = 'none';
            }
        });

        // Real-time client-side doctor filtering
        searchInput.addEventListener('input', function() {
            const query = this.value.trim().toLowerCase();
            if (!doctorCols.length) return;

            let visibleCount = 0;
            doctorCols.forEach(function(col) {
                const name = col.getAttribute('data-name') || '';
                const spec = col.getAttribute('data-speciality') || '';
                const qual = col.getAttribute('data-qual') || '';

                if (name.includes(query) || spec.includes(query) || qual.includes(query)) {
                    col.style.display = 'block';
                    visibleCount++;
                } else {
                    col.style.display = 'none';
                }
            });
        });
    }

    // Modal popup loading via jQuery
    if (window.jQuery) {
        $(document).on('click', '.open_modal_enquiry', function(e) {
            e.preventDefault();
            const remoteUrl = $(this).data('remote');
            const modalEl = document.getElementById('enquiryModal');
            if (!modalEl) return;
            const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);

            $('#modal-body').html('<div class="text-center py-4"><i class="fa fa-spinner fa-spin fa-2x text-primary"></i><p class="mt-2 text-muted">Loading appointment form...</p></div>');
            modal.show();

            $.get(remoteUrl, function(data) {
                $('#modal-body').html(data);
            }).fail(function() {
                $('#modal-body').html('<div class="alert alert-danger">Unable to load appointment form. Please try calling us directly.</div>');
            });
        });
    }

    const callbackForm = document.getElementById('callbackForm');
    if (callbackForm) {
        callbackForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitCallback');
            const statusDiv = document.getElementById('callbackFormStatus');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin me-2"></i> Submitting...';

            const formData = new FormData(callbackForm);
            const params = new URLSearchParams(formData);

            fetch(callbackForm.action, {
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: params.toString()
            })
            .then(res => res.json())
            .then(data => {
                btn.disabled = false;
                btn.innerHTML = originalText;
                if (data.status === 'success' || data.success) {
                    statusDiv.innerHTML = '<div class="alert alert-success d-flex align-items-center mb-3"><i class="fas fa-check-circle me-2 fs-5"></i><div><strong>Thank You!</strong> Callback request submitted. Our team will contact you shortly.</div></div>';
                    callbackForm.reset();
                    setTimeout(function() {
                        const modalEl = document.getElementById('callbackModal');
                        if (modalEl && window.bootstrap) {
                            const modal = bootstrap.Modal.getInstance(modalEl);
                            if (modal) modal.hide();
                        }
                    }, 2500);
                } else {
                    statusDiv.innerHTML = '<div class="alert alert-danger mb-3">' + (data.message || 'Error submitting request. Please try again.') + '</div>';
                }
            })
            .catch(err => {
                btn.disabled = false;
                btn.innerHTML = originalText;
                statusDiv.innerHTML = '<div class="alert alert-danger mb-3">Network error. Please try again or call our hotline.</div>';
            });
        });
    }
});
</script>
