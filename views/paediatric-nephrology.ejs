<section class="app-sec p-bottom" id="book_sectio">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="mb-4 text-center fade-up animatable">
                    <h2 class="step_heading">Book Your Appointment</h2>
                </div>

                <!-- Step Progress -->
                <div class="booking-steps fade-up animatable">
                    <div class="step-indicator">
                        <div class="step-item active" id="step-indicator-1">
                            <div class="step-dot">1</div>
                            <span>Your details</span>
                        </div>
                        <div class="step-line"></div>
                        <div class="step-item" id="step-indicator-2">
                            <div class="step-dot">2</div>
                            <span>Appointment details</span>
                        </div>
                    </div>
                </div>

                <div class="booking-form fade-up animatable">
                    <div id="mess_appointment"></div>
                    <div id="loading_appointment_img" style="display:none;" class="text-center py-2 text-primary">
                        <i class="fa fa-spinner fa-spin"></i> Please wait..
                    </div>

                    <!-- Step 1: Patient basics -->
                    <div class="booking-step" id="booking-step-1">
                        <form class="appointment-form fadeInUp animated" name="book-appointment-form-step-1" id="book-appointment-form-step-1" method="post">
