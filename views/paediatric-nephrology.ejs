<link rel="stylesheet" href="/css/inner_style.css">

<style>
/* Step Indicator & Appointment Form Styles */
.step-dot {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid var(--grey-300);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
}
.step-item.active .step-dot { 
    border-color: var(--brand-blue-1); 
    color: var(--snd-color, var(--brand-orange)); 
}
.step-item.done .step-dot {
    border-color: var(--brand-blue-1);
    background: var(--brand-blue-1);
    color: var(--white);
}
.step-line {
    flex: 1;
    height: 1px;
    background: var(--grey-200);
    margin: 0 12px;
}
.submit-btn--outline {
    background: transparent;
    border: 2px solid currentColor;
    color: var(--grey-700);
}
.appoint {
    gap: 24px;
}
.booking-steps {
    width: 57%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 0 auto 25px;
}
.step-indicator {
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.step-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 400;
    font-size: 14px;
    color: var(--grey-700);
}
.step-item.active {
    color: var(--brand-blue-2);
    font-weight: 700;
}
h2.step_heading {
    font-size: 24px;
    margin-bottom: 20px;
    color: var(--brand-blue-2-tint-1);
    font-weight: 700;
}
@media only screen and (min-width: 320px) and (max-width: 767px) {
    .booking-steps {
        width: 100%;
        margin: auto;
    }
}
/* Ensure Fancybox thumbnails and hover plus work cleanly */
.doctors-item {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
}
.doctors-item .right-plus {
    position: absolute;
    bottom: 15px;
    right: 15px;
    width: 36px;
    height: 36px;
    background: rgba(var(--white-rgb), 0.9);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
}
.doctors-item:hover .right-plus {
    transform: scale(1.15) rotate(90deg);
}
.doctors-item .right-plus img {
    width: 18px;
    height: 18px;
}
/* Callback Button */
.callback-btn {
    position: fixed;
    right: 0;
    top: 50%;
    transform: translateY(-50%) rotate(-90deg);
    transform-origin: right bottom;
    background: var(--brand-orange);
    color: var(--brand-blue-2-tint-3);
    padding: 10px 20px;
    border-radius: 8px 8px 0 0;
    font-weight: 700;
    font-size: 14px;
    z-index: 999;
    text-decoration: none;
    box-shadow: -2px 0 10px rgba(var(--black-rgb), 0.15);
}
.callback-btn:hover {
    background: var(--brand-blue-2);
    color: var(--white);
}
</style>

