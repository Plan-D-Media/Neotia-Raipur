<%- include('partials/header', { 
    title: 'Thank You for Your Enquiry | Neotia Bhagirathi Raipur',
    description: 'Enquiry received at Neotia Bhagirathi Hospital.'
}) %>

<section class="section-padding text-center" style="padding-top: 140px; padding-bottom: 90px; background: var(--grey-bg);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm p-5" style="border-radius: 20px; background: var(--white);">
                    <div class="d-inline-flex align-items-center justify-content-center mx-auto mb-4" style="width: 80px; height: 80px; border-radius: 50%; background: var(--grey-bg); color: var(--ui-success); font-size: 36px;">
                        <i class="fas fa-phone-volume"></i>
                    </div>
                    <h2 style="color: var(--theme-color); font-weight: 700; font-size: 32px; margin-bottom: 12px;">Callback Request Received!</h2>
                    <p style="color: var(--grey-700); font-size: 16px; line-height: 1.7; margin-bottom: 24px;">
                        Thank you for contacting Neotia Bhagirathi Woman and Child Care Centre. Our patient care representative will call you back within 15 to 30 minutes to assist you.
                    </p>

                    <div class="d-flex justify-content-center gap-3">
                        <a href="/" class="btn" style="background: var(--theme-color); color: var(--white); font-weight: 700; border-radius: 25px; padding: 10px 28px;">
                            <i class="fas fa-home me-2"></i> Return to Homepage
                        </a>
                        <a href="/contact" class="btn btn-outline-primary" style="font-weight: 700; border-radius: 25px; padding: 10px 24px;">
                            Contact Information
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
