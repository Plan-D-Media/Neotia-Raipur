                                </div>
                                <div class="col-lg-6">
                                    <input type="text" class="form-control" placeholder="Mobile" inputmode="numeric" pattern="[0-9]*" name="mobile" id="mobile" required>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-12 text-end">
                                    <input type="hidden" name="hlink" value="/vaccination" />
                                    <input type="hidden" name="ip" value="127.0.0.1" />
                                    <input name="step" type="hidden" value="1">
                                    <input name="getanappointment" type="hidden" value="1">
                                    <input type="hidden" name="recaptcha_response" id="recaptchaResponse">
                                    <button type="submit" id="appointsubmitTriger" class="submit-btn">Next &rarr;</button>
                                </div>
                            </div>
                        </form>
                    </div>
                    <!-- Step 1: Patient basics end -->

                    <!-- Step 2: Appointment details start -->
                    <div class="booking-step" id="booking-step-2" style="display:none;">
                        <form class="appointment-form fadeInUp animated" name="book-appointment-form-step-2" id="book-appointment-form-step-2" method="post">
                            <div class="row">
                                <div class="col-lg-6">
                                    <input type="email" class="form-control" placeholder="Email Id" name="email" id="email" required>
                                    <select class="form-select" disabled>
                                        <option value="7##Vaccination & Immunisation" selected>Vaccination &amp; Immunisation</option>
                                    </select>
                                    <input type="hidden" name="department" id="department" value="7##Vaccination & Immunisation">
                                </div>
                                <div class="col-lg-6">
                                    <select class="form-select" name="consultant" id="consultant" required>
                                        <option value="">Select Doctor</option>
                                        <option value="Any Doctor" selected>Any Doctor</option>
                                        <option value="13##Dr. Niladri Bose">Dr. Niladri Bose (Newborn & Child Specialist)</option>
                                        <option value="12##Dr. Afzal Hussain">Dr. Afzal Hussain (Paediatrician & Neonatologist)</option>
                                        <option value="14##Dr. Sulagna Dutta">Dr. Sulagna Dutta (Paediatrics & Neonatology)</option>
                                        <option value="9##Dr. Somenath Gorain">Dr. Somenath Gorain (Paediatric Specialist)</option>
                                    </select>
                                    <div class="date-wrapper position-relative">
                                        <input type="date" class="form-control" placeholder="Date" min="<%= new Date().toISOString().split('T')[0] %>" name="preffered_date" id="preffered_date" required>
                                        <span class="calendar-icon"><i class="fa-solid fa-calendar-days"></i></span>
                                    </div>
                                    <input type="hidden" name="hospital_center" class="form-control readonly-field" value="<%= siteInfo.hospitalCentre %>" readonly>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-12 d-flex justify-content-between appoint">
                                    <button type="button" class="submit-btn submit-btn--outline" id="step2-prev-btn">&larr; Back</button>
                                    <input name="step" type="hidden" value="2">
                                    <input name="getanappointment" type="hidden" value="1">
                                    <button type="submit" id="appointsubmitTriger_2" class="submit-btn">Submit Request</button>
                                </div>
                            </div>
                        </form>
                    </div>
                    <!-- Step 2: Appointment details end -->
                </div>
            </div>
        </div>
    </div>
</section>
