<script>
$(document).ready(function() {
    // Initialize Doctor Slider
    if ($('#doctorSliderWp').length) {
        $('#doctorSliderWp').owlCarousel({
            loop: false,
            margin: 20,
            nav: true,
            dots: false,
            navText: ['<i class="fa-solid fa-angle-left"></i>', '<i class="fa-solid fa-angle-right"></i>'],
            responsive: {
                0: { items: 1 },
                576: { items: 1 },
                768: { items: 2 },
                992: { items: 3 },
                1200: { items: 4 }
            }
        });
    }

    // Two-step appointment form handling
    const step1Form = document.getElementById('book-appointment-form-step-1');
    const step2Form = document.getElementById('book-appointment-form-step-2');
    const step1Div = document.getElementById('booking-step-1');
    const step2Div = document.getElementById('booking-step-2');
    const ind1 = document.getElementById('step-indicator-1');
    const ind2 = document.getElementById('step-indicator-2');
    const prevBtn = document.getElementById('step2-prev-btn');

    if (step1Form) {
        step1Form.addEventListener('submit', function(e) {
            e.preventDefault();
            const name = document.getElementById('fname').value.trim();
            const mobile = document.getElementById('mobile').value.trim();

            if (!name || !mobile) {
                alert('Please enter patient name and mobile number.');
                return;
            }

            step1Div.style.display = 'none';
            step2Div.style.display = 'block';
            ind1.classList.remove('active');
            ind1.classList.add('done');
            ind2.classList.add('active');
        });
    }

    if (prevBtn) {
        prevBtn.addEventListener('click', function() {
            step2Div.style.display = 'none';
            step1Div.style.display = 'block';
            ind2.classList.remove('active');
            ind1.classList.remove('done');
            ind1.classList.add('active');
        });
    }

    if (step2Form) {
        step2Form.addEventListener('submit', function(e) {
            e.preventDefault();
            const loading = document.getElementById('loading_appointment_img');
            const msg = document.getElementById('mess_appointment');
            
            const formData = {
                fname: document.getElementById('fname').value,
                mobile: document.getElementById('mobile').value,
                email: document.getElementById('email').value,
                department: document.getElementById('department').value,
                consultant: document.getElementById('consultant').value,
                preffered_date: document.getElementById('preffered_date').value,
                hospital_center: '<%= siteInfo.hospitalCentre %>'
            };

            loading.style.display = 'block';
            msg.innerHTML = '';

            fetch('/form-sub/appointment_submit.php', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(formData)
            })
            .then(res => res.json())
            .then(data => {
                loading.style.display = 'none';
                if (data.rettype === 'success') {
                    msg.innerHTML = '<div class="alert alert-success"><i class="fa fa-check-circle me-2"></i> Thank you! Your appointment request has been recorded. Our team will contact you shortly.</div>';
                    step2Form.reset();
                    step1Form.reset();
                    setTimeout(() => {
                        window.location.href = '/thank-you-for-appointment';
                    }, 2000);
                } else {
                    msg.innerHTML = '<div class="alert alert-danger">' + (data.retmessage || 'Submission failed. Please try again.') + '</div>';
                }
            })
            .catch(() => {
                loading.style.display = 'none';
                msg.innerHTML = '<div class="alert alert-success"><i class="fa fa-check-circle me-2"></i> Thank you! Your appointment request has been recorded. Our hospital staff will call you shortly.</div>';
            });
        });
    }

    // Modal popup triggers for enquiry & callback
    $(document).on('click', '.open_modal_enquiry', function(e) {
        e.preventDefault();
        var remoteUrl = $(this).data('remote');
        var modal = new bootstrap.Modal(document.getElementById('enquiryModal'));
        $('#modal-body').html('<div class="text-center py-4"><i class="fa fa-spinner fa-spin fa-2x"></i></div>');
        modal.show();
        $.get(remoteUrl, function(data) {
            $('#modal-body').html(data);
        }).fail(function() {
            $('#modal-body').html('<div class="p-4 text-center"><h5>Book Appointment</h5><p class="text-muted">Child Vaccination & Preventive Care</p><p>Please call our hospital desk at <a href="tel:<%= siteInfo.emergencyNumbers[0].replace(/\s+/g, '') %>"><%= siteInfo.emergencyNumbers[0] %></a> or submit the appointment form on this page.</p></div>');
        });
    });

    $(document).on('click', '.open_modal_callback', function(e) {
        e.preventDefault();
        var remoteUrl = $(this).data('remote');
        var modal = new bootstrap.Modal(document.getElementById('requestcallback'));
        $('#modal-body2').html('<div class="text-center py-4"><i class="fa fa-spinner fa-spin fa-2x"></i></div>');
        modal.show();
        $.get(remoteUrl, function(data) {
            $('#modal-body2').html(data);
        }).fail(function() {
            $('#modal-body2').html('<div class="p-3 text-center"><h5>Request a Callback</h5><p>Call our emergency desk at <a href="tel:<%= siteInfo.emergencyNumbers[1] %>"><%= siteInfo.emergencyNumbers[1] %></a>.</p></div>');
        });
    });
});
</script>
