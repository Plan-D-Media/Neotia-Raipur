<%- include('partials/header', { 
    title: 'Vaccination & Immunisation in Raipur | Neotia Bhagirathi',
    description: 'Neotia Bhagirathi provides child vaccination and preventive care in Raipur, including flu, measles, HPV vaccines and immunisation packages.',
    bodyClass: 'specalities'
}) %>

<link rel="stylesheet" href="/css/inner_style.css">

<style>
/* Step Indicator & Appointment Form Styles */
.step-dot {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid var(--grey-300);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
}
.step-item.active .step-dot { 
    border-color: var(--brand-blue-1); 
    color: var(--snd-color, var(--brand-orange)); 
}
.step-item.done .step-dot {
    border-color: var(--brand-blue-1);
    background: var(--brand-blue-1);
    color: var(--white);
}
.step-line {
    flex: 1;
    height: 1px;
    background: var(--grey-200);
    margin: 0 12px;
}
.submit-btn--outline {
    background: transparent;
    border: 2px solid currentColor;
    color: var(--grey-700);
}
.appoint {
    gap: 24px;
}
.booking-steps {
    width: 57%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 0 auto 25px;
}
.step-indicator {
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.step-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--grey-400);
}
.step-item.active {
    color: var(--grey-800);
    font-weight: 700;
}
.step-item.done {
    color: var(--black);
}

@media only screen and (min-width: 320px) and (max-width: 767px) {
    .booking-steps {
        width: 100%;
    }
}

/* Banner image styling */
.banner-sec {
    background: var(--grey-bg);
    padding-top: 170px !important;
    padding-bottom: 55px !important;
    position: relative;
}
@media (max-width: 991px) {
    .banner-sec {
        padding-top: 105px !important;
        padding-bottom: 40px !important;
    }
}
.banner-area .banner-img img {
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(var(--brand-blue-1-rgb), 0.12);
    width: 100%;
    max-height: 440px;
    object-fit: cover;
}

/* Speciality banner in content */
.speciality_banner_no {
    list-style: none !important;
    padding: 0 !important;
    margin: 30px 0 !important;
    text-align: center;
    grid-column: 1 / -1;
}
.speciality_banner_no img {
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(var(--black-rgb), 0.06);
    max-width: 100%;
}

/* Doctor card modern touch */
.sec00-doctorwp .item {
    margin: 10px;
    background: var(--white);
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(var(--black-rgb), 0.06);
    padding: 20px;
    text-align: center;
    border: 1px solid var(--grey-100);
    transition: all 0.3s ease;
}
.sec00-doctorwp .item:hover {
    box-shadow: 0 8px 24px rgba(var(--brand-blue-1-rgb), 0.12);
    transform: translateY(-4px);
}
.sec00-doctorwp .img-doctor img {
    width: 140px;
    height: 140px;
    object-fit: cover;
    border-radius: 50%;
    margin: 0 auto 15px;
    border: 3px solid var(--grey-100);
}
.sec00-doctorwp .doctor-name {
    font-size: 18px;
    font-weight: 700;
    color: var(--brand-blue-1);
    margin-bottom: 6px;
}
.sec00-doctorwp .doctor-content h5 {
    font-size: 14px;
    color: var(--brand-blue-1);
    font-weight: 700;
    margin-bottom: 8px;
}
.sec00-doctorwp .doctor-content p {
    font-size: 13px;
    color: var(--grey-600);
    line-height: 1.5;
    margin-bottom: 15px;
}
.sec00-doctorwp .book-app {
    display: inline-block;
    padding: 9px 24px;
    background: var(--brand-blue-1);
    color: var(--white);
    border-radius: 6px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.3s ease;
}
.sec00-doctorwp .book-app:hover {
    background: var(--brand-orange);
    color: var(--brand-blue-2-tint-3);
}
</style>

<!-- Request a Call Back Button -->
<a href="javascript:void(0)" class="callback-btn open_modal_callback" data-remote="/request-a-callback">
