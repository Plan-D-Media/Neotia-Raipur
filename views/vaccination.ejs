<!-- content tabs sec start -->
<section class="content-tabs-sec section-padding">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="panels">
                    <section id="tab1" class="panel active fade-in" role="tabpanel" aria-labelledby="t1">
                        <h3 class="fadeInUp animatable">Paediatric Vaccination and Preventive Care</h3>
                        <p class="fadeInUp animatable">At our Paediatric Preventive Care Department, we focus on keeping children healthy and well from birth through adolescence. Our comprehensive approach integrates the latest immunisation guidelines, regular health screenings and personalised advice to manage risks and promote optimal physical and developmental growth.</p>
                        <p class="pt-4 fadeInUp animatable">Our Specialised Services include:</p>
                        
                        <div class="workup-sec mt-5">
                            <h4 class="py-3 fadeInUp animatable">Immunisation and Infectious Disease Prevention</h4>
                            <ul class="listing-apps">
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Standard Immunisation Schedule</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>Routine Vaccinations: </strong>Administration of all core vaccines according to national guidelines (e.g., MMR, DTaP, Polio, Hib, Pneumococcal, Rotavirus, Meningococcal and Hepatitis).</p>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>Catch-Up Schedules: </strong>Developing and implementing personalised plans for children who have missed or delayed vaccinations.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div>
                                        <h5>Seasonal and Travel Vaccinations</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>Influenza (Flu) Vaccine: </strong>Annual administration for all eligible children to prevent seasonal illness.</p>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>Travel Consultations: </strong>Providing necessary vaccines (e.g., Yellow Fever, Typhoid) and prophylactic medications for families travelling internationally.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Infectious Disease Risk Management</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>Exposure Counselling: </strong>Guidance and testing following exposure to common childhood diseases (e.g., chickenpox, pertussis).</p>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>Antibiotic Stewardship: </strong>Promoting responsible use of antibiotics to combat drug resistance.</p>
                                    </div>
                                </li>
                            </ul>

                            <h4 class="py-3 mt-4 fadeInUp animatable">Health Surveillance and Screening</h4>
                            <ul class="listing-apps">
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Physical Growth and Vitals Monitoring</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>Physical Examination: </strong>Comprehensive assessment of growth (height, weight, head circumference) and physical health at routine intervals.</p>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>Vision and Hearing Screening: </strong>Early detection of sensory impairments that can affect learning and development.</p>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>Blood Pressure and Anaemia Screening: </strong>Monitoring for hypertension and nutritional deficiencies at appropriate ages.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable speciality_banner_no">
                                    <img class="img-fluid speciality_banner" src="/upload/fileManager/specialise_banner/PaediatricVaccination.png" alt="Paediatric Vaccination Speciality Banner" />
                                </li>
                                <li class="fadeInUp animatable">
                                    <div>
                                        <h5>Developmental and Behavioural Screening</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>Standardised Screening Tools: </strong>Routine use of validated questionnaires (e.g., ASQ, M-CHAT) to identify potential delays in motor, speech, cognitive and social development.</p>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>Early Intervention Referrals: </strong>Prompt referral to specialists (e.g., Speech Therapy, Occupational Therapy, Child Psychology) when concerns are identified.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Adolescent Health Screening</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>Mental Health Assessment: </strong>Screening for depression, anxiety, substance use and eating disorders.</p>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>Sexual Health Counselling: </strong>Confidential, age-appropriate advice and testing services.</p>
                                    </div>
                                </li>
                            </ul>

                            <h4 class="py-3 mt-4 fadeInUp animatable">Health Education and Risk Reduction</h4>
                            <ul class="listing-apps">
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Nutrition and Healthy Lifestyle Guidance</h5>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>Dietary Counselling: </strong>Personalised advice to prevent obesity, manage nutritional deficiencies and establish healthy eating habits.</p>
                                    </div>
                                    <div class="mb-2">
                                        <p><strong>Physical Activity Promotion: </strong>Encouraging age-appropriate exercise to support bone health and cardiovascular fitness.</p>
                                    </div>
                                </li>
                                <li class="fadeInUp animatable">
                                    <div class="mb-2">
                                        <h5>Injury and Accident Prevention</h5>
                                    </div>
                                    <div class="mb-2">
