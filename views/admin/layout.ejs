<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= typeof title !== 'undefined' ? title : 'Admin CMS Portal | Neotia Bhagirathi' %></title>
    
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
    <link rel="icon" type="image/png" sizes="48x48" href="/img/favicon.png">
    <link rel="shortcut icon" href="/favicon.ico">
    <!-- Bootstrap 5 & FontAwesome -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/brand-tokens.css?v=6.0">
    
    <style>
        :root {
            --sidebar-width: 260px;
            --admin-primary: var(--brand-blue-2);
            --admin-accent: var(--brand-orange);
            --admin-bg: var(--grey-bg);
        }
        h1, h2, h3, h4, h5, h6, .btn {
            font-weight: 700;
        }
        body {
            font-family: var(--font-brand);
            background-color: var(--admin-bg);
            margin: 0;
            padding: 0;
            color: var(--brand-blue-2-tint-3);
        }
        .admin-sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background: var(--brand-blue-2-tint-3);
            color: var(--white);
            z-index: 100;
            overflow-y: auto;
            transition: all 0.3s ease;
        }
        .sidebar-brand {
            padding: 22px 20px;
            font-size: 17px;
            font-weight: 700;
            color: var(--white);
            border-bottom: 1px solid rgba(var(--white-rgb), 0.08);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .sidebar-menu {
            list-style: none;
            padding: 15px 10px;
            margin: 0;
        }
        .sidebar-menu li a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            color: var(--grey-600);
            text-decoration: none;
            border-radius: 8px;
            font-weight: 400;
            font-size: 14px;
            transition: all 0.2s;
            margin-bottom: 4px;
        }
        .sidebar-menu li a:hover,
        .sidebar-menu li a.active {
            color: var(--white);
            background: rgba(var(--white-rgb), 0.1);
        }
        .sidebar-menu li a.active {
            background: var(--admin-primary);
            color: var(--white);
        }
        .admin-main {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .admin-topbar {
            background: var(--white);
            height: 65px;
            padding: 0 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--grey-100);
            position: sticky;
            top: 0;
            z-index: 90;
        }
        .admin-content {
            padding: 30px;
            flex: 1;
        }
        .stat-card {
            background: var(--white);
            border-radius: 12px;
            padding: 24px;
            border: 1px solid var(--grey-100);
            box-shadow: 0 2px 4px rgba(var(--black-rgb), 0.02);
            transition: transform 0.2s;
        }
        .stat-card:hover {
            transform: translateY(-2px);
        }
        .table-card {
            background: var(--white);
            border-radius: 12px;
            border: 1px solid var(--grey-100);
            overflow: hidden;
            box-shadow: 0 2px 4px rgba(var(--black-rgb), 0.02);
        }
        .badge-status-New { background: var(--grey-bg); color: var(--ui-error); }
        .badge-status-Confirmed { background: var(--grey-bg); color: var(--ui-success); }
        .badge-status-Contacted { background: var(--grey-bg); color: var(--brand-blue-1); }
        .badge-status-Completed { background: var(--grey-bg); color: var(--brand-blue-1); }
        .badge-status-Cancelled { background: var(--grey-bg); color: var(--grey-600); }
        .badge-status-published { background: var(--grey-bg); color: var(--ui-success); border: 1px solid var(--grey-100); }
        .badge-status-draft { background: var(--grey-bg); color: var(--brand-blue-1); border: 1px solid var(--grey-100); }
        .badge-status-trashed { background: var(--grey-bg); color: var(--ui-error); border: 1px solid var(--grey-200); }
        .badge-status-scheduled { background: var(--grey-bg); color: var(--brand-blue-1-tint-3); border: 1px solid var(--brand-blue-1); }
        .badge-seo-complete { background: var(--grey-bg); color: var(--ui-success); border: 1px solid var(--ui-success); font-size: 11px; }
        .badge-seo-attention { background: var(--grey-bg); color: var(--brand-blue-1); border: 1px solid var(--grey-100); font-size: 11px; }
        .badge-seo-incomplete { background: var(--grey-bg); color: var(--ui-error); border: 1px solid var(--grey-200); font-size: 11px; }
    </style>
</head>
<body>

    <!-- Sidebar Navigation -->
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <i class="fas fa-hospital text-warning" style="font-size: 22px;"></i>
            <span>Neotia Admin CMS</span>
        </div>
        <ul class="sidebar-menu">
            <li>
                <a href="/admin" class="<%= activeTab === 'dashboard' ? 'active' : '' %>">
                    <i class="fas fa-tachometer-alt"></i> Dashboard
                </a>
            </li>
            <li>
                <a href="/admin/pages" class="<%= activeTab === 'pages' ? 'active' : '' %>">
                    <i class="fas fa-layer-group"></i> Website Pages
                </a>
            </li>
            <li>
                <a href="/admin/appointments" class="<%= activeTab === 'appointments' ? 'active' : '' %>">
                    <i class="fas fa-calendar-check"></i> Appointments
                </a>
            </li>
            <li>
                <a href="/admin/enquiries" class="<%= activeTab === 'enquiries' ? 'active' : '' %>">
                    <i class="fas fa-phone-volume"></i> Callbacks &amp; Leads
                </a>
            </li>
            <li>
                <a href="/admin/doctors" class="<%= activeTab === 'doctors' ? 'active' : '' %>">
                    <i class="fas fa-user-md"></i> Doctors &amp; Specialists
                </a>
            </li>
            <li>
                <a href="/admin/services" class="<%= activeTab === 'services' ? 'active' : '' %>">
                    <i class="fas fa-stethoscope"></i> Clinical Services
                </a>
            </li>
            <li>
                <a href="/admin/blogs" class="<%= activeTab === 'blogs' ? 'active' : '' %>">
                    <i class="fas fa-newspaper"></i> Health Articles
                </a>
            </li>
            <li>
                <a href="/admin/settings" class="<%= activeTab === 'settings' ? 'active' : '' %>">
                    <i class="fas fa-cog"></i> Hospital Settings
                </a>
            </li>
            <li class="mt-4 pt-3 border-top border-secondary">
                <a href="/" target="_blank">
                    <i class="fas fa-external-link-alt"></i> View Live Website
                </a>
            </li>
            <li>
                <a href="/admin/logout" class="text-danger">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </li>
        </ul>
    </aside>

    <!-- Main Admin Content Area -->
    <div class="admin-main">
        <div class="admin-topbar">
            <div>
                <h5 class="mb-0 font-weight-bold" style="color: var(--brand-blue-2-tint-3);"><%= pageHeading %></h5>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small">Logged in as <strong><%= adminUser ? adminUser.name : 'Administrator' %></strong></span>
                <a href="/admin/logout" class="btn btn-sm btn-outline-danger" style="border-radius: 20px;">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </div>
        </div>

        <div class="admin-content">
            <%- body %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
