<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Staff Login | Neotia Bhagirathi CMS</title>
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
    <link rel="icon" type="image/png" sizes="48x48" href="/img/favicon.png">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/brand-tokens.css?v=6.0">
    <style>
        body {
            background: linear-gradient(135deg, var(--brand-blue-2-tint-3) 0%, var(--brand-blue-2-tint-3) 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-brand);
        }
        .login-card {
            width: 100%;
            max-width: 420px;
            background: var(--white);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(var(--black-rgb), 0.3);
            overflow: hidden;
        }
        .login-header {
            background: var(--brand-blue-2);
            padding: 30px 20px;
            text-align: center;
            color: var(--white);
        }
        .login-body {
            padding: 35px 30px;
        }
        h1, h2, h3, h4, h5, h6, .btn {
            font-weight: 700;
        }
        /* The logo only ever sits on white, with at least one plus-arm of clear space */
        .login-logo {
            background: var(--white);
            padding: 24px 24px 20px;
            text-align: center;
        }
        .login-logo img {
            height: 64px;
            width: auto;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="login-logo">
            <img src="/img/neotia-raipur-logo.svg" alt="Neotia Bhagirathi Woman and Child Care Centre Raipur Logo" width="156" height="64">
        </div>
        <div class="login-header">
            <h5 class="mb-0 text-white font-weight-bold">Staff &amp; Admin Portal</h5>
            <small style="color: rgba(var(--white-rgb), 0.85);">Neotia Bhagirathi Hospital Management</small>
        </div>

        <div class="login-body">
            <% if (error) { %>
                <div class="alert alert-danger py-2 small mb-4">
                    <i class="fas fa-exclamation-triangle me-1"></i> <%= error %>
                </div>
            <% } %>

            <form action="/admin/login" method="POST">
                <div class="mb-3">
                    <label class="form-label font-weight-bold small text-muted">USERNAME</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-user text-muted"></i></span>
                        <input type="text" name="username" class="form-control" placeholder="Enter username" value="admin" required>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label font-weight-bold small text-muted">PASSWORD</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-lock text-muted"></i></span>
                        <input type="password" name="password" class="form-control" placeholder="Enter password" required>
                    </div>
                </div>

                <button type="submit" class="btn w-100 py-2 font-weight-bold" style="background: var(--brand-orange); border-radius: 25px; border: none; font-size: 15px; color: var(--brand-blue-2-tint-3);">
                    Sign In to Dashboard <i class="fas fa-arrow-right ms-2"></i>
                </button>
            </form>

            <div class="text-center mt-4 pt-3 border-top">
                <a href="/" class="text-muted small text-decoration-none">
                    <i class="fas fa-chevron-left me-1"></i> Return to Main Website
                </a>
            </div>
        </div>
    </div>

</body>
</html>
