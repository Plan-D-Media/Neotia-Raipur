<!-- Doctors Management -->
<div class="table-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h5 class="mb-0 fw-bold">Doctor Profiles (<%= doctors.length %>)</h5>
            <small class="text-muted">Manage hospital faculty, specialities, qualifications, and schedules</small>
        </div>
        <a href="/admin/doctors/new" class="btn btn-primary" style="border-radius: 8px;">
            <i class="fas fa-user-plus me-1"></i> Add New Doctor
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Doctor</th>
                    <th>Speciality</th>
                    <th>Qualifications</th>
                    <th>Slug / Profile URL</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody class="small">
                <% doctors.forEach(doc => { %>
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="<%= doc.image ? (doc.image.startsWith('http') ? doc.image : (doc.image.startsWith('/') ? doc.image : '/' + doc.image)) : '/img/about-img.png' %>" alt="<%= doc.name %>" style="width: 44px; height: 44px; border-radius: 50%; object-fit: cover;" onerror="this.src='/img/about-img.png'">
                                <div>
                                    <strong class="d-block text-dark"><%= doc.name %></strong>
                                    <% if (doc.designation) { %>
                                        <small class="text-muted"><%= doc.designation %></small>
                                    <% } %>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-light text-primary border"><%= doc.speciality %></span>
                        </td>
                        <td>
                            <div class="text-muted" style="max-width: 280px; line-height: 1.4;"><%= doc.qualifications || 'Consultant Specialist' %></div>
                        </td>
                        <td>
                            <code>/doctor/<%= doc.slug %></code>
                        </td>
                        <td>
                            <a href="/doctor/<%= doc.slug %>" target="_blank" class="btn btn-sm btn-outline-secondary me-1" title="View Profile">
                                <i class="fas fa-external-link-alt"></i>
                            </a>
                            <a href="/admin/doctors/<%= doc.id %>/edit" class="btn btn-sm btn-outline-primary me-1" title="Edit Doctor">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form action="/admin/doctors/<%= doc.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to remove <%= doc.name %>?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>
