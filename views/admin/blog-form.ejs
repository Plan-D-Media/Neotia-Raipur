<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="table-card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <h5 class="mb-0 fw-bold"><%= isEdit ? 'Edit Health Article' : 'Write New Health Article' %></h5>
                <a href="/admin/blogs" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Back to Articles
                </a>
            </div>

            <form action="<%= isEdit ? '/admin/blogs/' + blog.id + '/edit' : '/admin/blogs/new' %>" method="POST">
                <div class="mb-3">
                    <label class="form-label font-weight-bold small">Article Title <span class="text-danger">*</span></label>
                    <input type="text" name="title" class="form-control" value="<%= blog.title || '' %>" placeholder="e.g. Signs of Paediatric Gastroenterology Parents Should Never Ignore" required>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label font-weight-bold small">URL Slug <span class="text-danger">*</span></label>
                        <input type="text" name="slug" class="form-control" value="<%= blog.slug || '' %>" placeholder="e.g. signs-parents-should-never-ignore" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label font-weight-bold small">Published Date</label>
                        <input type="text" name="date" class="form-control" value="<%= blog.date || 'December 2025' %>" placeholder="e.g. December 2025">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-bold small">Featured Image URL or Path</label>
                    <input type="text" name="image" class="form-control" value="<%= blog.image || '' %>" placeholder="e.g. /upload/fileManager/... or /img/about-img.png">
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-bold small">Short Summary / Excerpt</label>
                    <textarea name="excerpt" class="form-control" rows="2" placeholder="Brief 1-2 sentence preview for cards and meta description..."><%= blog.excerpt || '' %></textarea>
                </div>

                <div class="mb-4">
                    <label class="form-label font-weight-bold small">Full Article Content (HTML or Markdown)</label>
                    <textarea name="content" class="form-control" rows="8" placeholder="Complete article text..."><%= blog.content || '' %></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="/admin/blogs" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary font-weight-bold px-4">
                        <%= isEdit ? 'Save Changes' : 'Publish Article' %>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
