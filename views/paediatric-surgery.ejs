<script>
document.addEventListener('DOMContentLoaded', function() {
    // Modal remote loading & Owl Carousel
    if (window.jQuery) {
        $(document).on('click', '.open_modal_enquiry', function() {
            var url = $(this).data('remote');
            $('#modal-body').html('<div class="text-center py-4"><i class="fa fa-spinner fa-spin fa-2x"></i></div>');
            $('#enquiryModal').modal('show');
            $.get(url, function(data) {
                $('#modal-body').html(data);
            }).fail(function() {
                $('#modal-body').html('<div class="alert alert-danger">Unable to load appointment form. Please try calling us directly.</div>');
            });
        });

        if ($('.doctors-area').length && $.fn.owlCarousel) {
            $('.doctors-area').owlCarousel({
                loop: false,
                margin: 20,
                nav: true,
                dots: false,
                responsive: {
                    0: { items: 1 },
                    600: { items: 2 },
                    1000: { items: 3 }
                }
            });
        }
        if ($('.sec00-doctorwp').length && $.fn.owlCarousel) {
            $('.sec00-doctorwp').owlCarousel({
                loop: false,
                margin: 20,
                nav: true,
                dots: false,
                responsive: {
                    0: { items: 1 },
                    600: { items: 2 },
                    1000: { items: 3 },
                    1200: { items: 4 }
                }
            });
        }
    }
});
</script>
