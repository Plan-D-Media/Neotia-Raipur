}
.step-indicator {
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.step-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--grey-400);
    font-size: 14px;
    font-weight: 400;
}
.step-item.active {
    color: var(--grey-900);
    font-weight: 700;
}
.step-item.done {
    color: var(--brand-blue-1);
}

