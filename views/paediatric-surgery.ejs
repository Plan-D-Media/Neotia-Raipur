<style>
/* The banner follows the booking form, which clears the header */
.banner-sec {
    padding-top: 55px !important;
    padding-bottom: 55px !important;
    position: relative;
    background: var(--grey-bg);
}
@media (max-width: 991px) {
    .banner-sec {
        padding-top: 40px !important;
        padding-bottom: 40px !important;
    }
}
.banner-area .banner-img img {
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(var(--brand-blue-1-rgb), 0.12);
    width: 100%;
    max-height: 440px;
    object-fit: cover;
}

/* Doctor card modern styling */
.sec00-doctorwp .item {
    margin: 10px;
    background: var(--white);
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(var(--black-rgb), 0.06);
    padding: 20px;
    text-align: center;
    border: 1px solid var(--grey-100);
    transition: all 0.3s ease;
}
.sec00-doctorwp .item:hover {
    box-shadow: 0 8px 24px rgba(var(--brand-blue-1-rgb), 0.12);
    transform: translateY(-4px);
}
.sec00-doctorwp .img-doctor img {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 15px;
    border: 3px solid var(--grey-100);
}
.sec00-doctorwp .doctor-content h5 {
    color: var(--brand-blue-1);
    font-size: 15px;
    font-weight: 700;
}
.sec00-doctorwp .book-app {
    display: inline-block;
    background: var(--brand-blue-1);
    color: var(--white);
    padding: 8px 20px;
    border-radius: 6px;
    margin-top: 12px;
    font-weight: 400;
    transition: all 0.3s;
}
.sec00-doctorwp .book-app:hover {
    background: var(--brand-blue-2);
    color: var(--white);
}
.speciality_banner {
    border-radius: 8px;
    margin: 20px 0;
    box-shadow: 0 4px 15px rgba(var(--black-rgb), 0.06);
}
.doctors-sec .right-plus {
    position: absolute;
    bottom: 15px;
    right: 15px;
    background: rgba(var(--white-rgb), 0.9);
    border-radius: 50%;
    padding: 8px;
    box-shadow: 0 2px 8px rgba(var(--black-rgb), 0.15);
}
.doctors-item {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    max-width: 480px;
}
.doctors-item img.img-fluid {
    width: 100%;
    display: block;
    border-radius: 8px;
    transition: transform 0.4s ease;
}
.doctors-item:hover img.img-fluid {
    transform: scale(1.03);
}
</style>

