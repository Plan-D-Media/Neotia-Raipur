                                <select class="form-select select_department" name="department" id="department" data-target="#consultant">
                                            <option>Speciality</option>
                                            <option value="10##Fertility and Reproductive Medicine">Fertility and Reproductive Medicine</option><option value="8##Foetal Medicine &amp; Maternal Care">Foetal Medicine &amp; Maternal Care</option><option value="19##IVF &amp; Infertility">IVF &amp; Infertility</option><option value="6##Neonatal Intensive Care">Neonatal Intensive Care</option><option value="9##Obstetrics and Gynaecology">Obstetrics and Gynaecology</option><option value="1##Paediatric Cardiac Sciences">Paediatric Cardiac Sciences</option><option value="17##Paediatric Dentistry">Paediatric Dentistry</option><option value="14##Paediatric Endocrinology">Paediatric Endocrinology</option><option value="16##Paediatric ENT">Paediatric ENT</option><option value="2##Paediatric Gastroenterology">Paediatric Gastroenterology</option><option value="15##Paediatric Medicine">Paediatric Medicine</option><option value="12##Paediatric Nephrology">Paediatric Nephrology</option><option value="3##Paediatric Neurology">Paediatric Neurology</option><option value="5##Paediatric Orthopaedics">Paediatric Orthopaedics</option><option value="4##Paediatric Surgery">Paediatric Surgery</option><option value="13##Paediatric Urology">Paediatric Urology</option>                                </select>
                                 
                            </div>

                            <div class="col-lg-6">
                                    
                                <select class="form-select " name="consultant" id="consultant" required="">
                                        <option>Doctor</option>
                                            
                                </select>
                                   

                                <div class="date-wrapper position-relative">
                                    <input type="date" class="form-control" placeholder="Date" min="2026-10-19" name="preffered_date" id="preffered_date" required="">
                                    <span class="calendar-icon"><i class="fa-solid fa-calendar-days calendar-icon"></i></span>
                                </div>

                                <input type="hidden" name="hospital_center" class="form-control readonly-field" value="NBWCCC, New Town" readonly="">
